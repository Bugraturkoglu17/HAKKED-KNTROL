# Bu dosyayı ".env" olarak kopyalayıp gerçek ayarlarınızı girin.
# ".env" dosyası .gitignore'dadır — asla GitHub'a push edilmez.

# AI_PROVIDER: "ollama" (varsayılan, yerel/çevrimdışı, kurumsal ağ engeline takılmaz)
# veya "openai" (bulut, OPENAI_API_KEY gerekir).
AI_PROVIDER=ollama

# --- Ollama (AI_PROVIDER=ollama iken kullanılır) ---
# Ollama kurulu ve "ollama pull qwen2.5vl:7b" ile model indirilmiş olmalı.
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (AI_PROVIDER=openai iken kullanılır) ---
OPENAI_API_KEY=BURAYA_OPENAI_API_KEY_GELECEK
OPENAI_MODEL=gpt-5.5

# Opsiyonel ayarlar (varsayılanlar yeterliyse dokunmayın):
# OPENAI_REASONING_EFFORT=medium
# OPENAI_MAX_CONCURRENCY=3
