# Bu dosyayı ".env" olarak kopyalayıp gerçek ayarlarınızı girin.
# ".env" dosyası .gitignore'dadır — asla GitHub'a push edilmez.

# --- Servis formu okuma (mağaza, tarih, gaz miktarı): Azure Document Intelligence ---
# Form numarası Windows OCR ile okunur; anahtar gerekmez.
AZURE_DI_ENDPOINT=BURAYA_AZURE_ENDPOINT_GELECEK
AZURE_DI_KEY=BURAYA_AZURE_KEY_GELECEK

# --- Hakediş Kontrolü yapay zekâsı: AI_PROVIDER "gemini" (varsayılan) veya "openai" ---
AI_PROVIDER=gemini

# --- Gemini (AI_PROVIDER=gemini iken kullanılır) ---
GEMINI_API_KEY=BURAYA_GEMINI_API_KEY_GELECEK
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI (AI_PROVIDER=openai iken kullanılır) ---
OPENAI_API_KEY=BURAYA_OPENAI_API_KEY_GELECEK
OPENAI_MODEL=gpt-5.5

# Opsiyonel ayarlar (varsayılanlar yeterliyse dokunmayın):
# OPENAI_REASONING_EFFORT=medium
# OPENAI_MAX_CONCURRENCY=3
