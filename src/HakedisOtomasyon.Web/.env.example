# Bu dosyayı ".env" olarak kopyalayıp gerçek API key'inizi girin.
# ".env" dosyası .gitignore'dadır — asla GitHub'a push edilmez.

OPENAI_API_KEY=BURAYA_OPENAI_API_KEY_GELECEK
OPENAI_MODEL=gpt-5.5

