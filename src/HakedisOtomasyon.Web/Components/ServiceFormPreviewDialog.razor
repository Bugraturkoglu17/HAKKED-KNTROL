@namespace HakedisOtomasyon.Web.Components

<MudDialog>
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                @FileName
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="fullscreen-preview-container">
            @if (IsPdf)
            {
                <object data="@FileUrl" type="application/pdf" class="fullscreen-preview-pdf">
                    <div style="padding:24px;color:white;text-align:center">
                        <p>Tarayıcı PDF görüntülemeyi desteklemiyor.</p>
                        <a href="@FileUrl" target="_blank" style="color:#90CAF9">Dosyayı İndir</a>
                    </div>
                </object>
            }
            else
            {
                <div class="fullscreen-preview-img-wrapper">
                    <img src="@FileUrl" alt="@FileName"
                         style="transform: scale(@_zoomCss); transform-origin: top center;
                                max-width: 100%; height: auto;
                                border-radius: 4px; box-shadow: 0 4px 24px rgba(0,0,0,0.6);
                                transition: transform 0.15s ease;" />
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (!IsPdf)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ZoomOut"
                           OnClick="ZoomOut"
                           Title="Uzaklaştır"
                           Disabled="@(_zoom <= 0.2)" />
            <MudText Typo="Typo.body2" Style="min-width:48px;text-align:center">
                @(((int)Math.Round(_zoom * 100)))%
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                           OnClick="ZoomIn"
                           Title="Yakınlaştır"
                           Disabled="@(_zoom >= 3.0)" />
            <MudIconButton Icon="@Icons.Material.Filled.FitScreen"
                           OnClick="FitScreen"
                           Title="Ekrana Sığdır (100%)" />
        }
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close"
                   OnClick="@(() => MudDialog.Close())">
            Kapat
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string FileUrl  { get; set; } = string.Empty;
    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public string FilePath { get; set; } = string.Empty;

    private double _zoom = 1.0;

    // ClosedXML double → CSS kullanımı için string ("1.0" formatı)
    private string _zoomCss => _zoom.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private bool IsPdf => !string.IsNullOrEmpty(FilePath) &&
        Path.GetExtension(FilePath).Equals(".pdf", StringComparison.OrdinalIgnoreCase);

    private void ZoomIn()    => _zoom = Math.Min(3.0,  Math.Round(_zoom + 0.25, 2));
    private void ZoomOut()   => _zoom = Math.Max(0.2,  Math.Round(_zoom - 0.25, 2));
    private void FitScreen() => _zoom = 1.0;
}
