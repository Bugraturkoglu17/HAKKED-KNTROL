@namespace HakedisOtomasyon.Web.Components
@using System.Globalization
@using HakedisOtomasyon.Application
@using HakedisOtomasyon.Domain.Enums
@inject IServiceFormService FormService
@inject IStoreService StoreService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Soğutma — Glikol Kullanım hakedişi, tek ekran:
   SOL: servis formu her zaman açık (eski sistem gibi) + form gezinmesi.
   SAĞ: o form için tek giriş alanı (mağaza, tarih, form no, miktar) → "Ekle" ile alt tabloya satır eklenir ve sıradaki forma geçilir.
   Glikol kalemi otomatik, servis ücreti yok. En sonda "Mağaza koduna göre diz": önce mağaza kodu, aynı mağazada tarih. *@

<style>
    .glycol-compact { font-size: 12.5px; }
    .glycol-compact .mud-input-slot, .glycol-compact input.mud-input-root { font-size: 13px; }
    .glycol-compact .mud-input-label { font-size: 12px; }
    .glycol-compact .mud-input.mud-input-outlined .mud-input-slot { padding-top: 7px; padding-bottom: 7px; }
    .glycol-compact table th { font-size: 11px; padding: 4px 6px; white-space: nowrap; }
    .glycol-compact table td { font-size: 12px; padding: 3px 6px; }
    .glycol-compact tr.glycol-row { cursor: pointer; }
    .glycol-compact tr.glycol-row-current td { background: #e3f2fd; }
</style>

<div class="glycol-compact">
<MudGrid Spacing="2">

    @* ───────── SOL: servis formu (daima açık) ───────── *@
    <MudItem xs="12" md="5">
        @if (Current is not null)
        {
            <PdfViewer @key="Current.Id" FileUrl="@Current.FileUrl" FileName="@Current.OriginalFileName" FilePath="@Current.FilePath" />
            <MudPaper Elevation="1" Class="pa-1 mt-2">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" Size="Size.Small" OnClick="PreviousFormAsync" Disabled="@(_index <= 0)" />
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2">Form @(_index + 1) / @AllForms.Count</MudText>
                        @if (IsAdded(Current))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Eklendi</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Bekliyor</MudChip>
                        }
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" Size="Size.Small" OnClick="NextFormAsync" Disabled="@(_index >= AllForms.Count - 1)" />
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center justify-center" Style="min-height:240px">
                <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mt-2" Align="Align.Center">Henüz servis formu yüklenmedi. Önceki adımdan formları yükleyin.</MudText>
            </MudPaper>
        }
    </MudItem>

    @* ───────── SAĞ: giriş alanı + tablo + özet ───────── *@
    <MudItem xs="12" md="7">
        <MudStack Spacing="2">

            @* Otomatik bilgiler *@
            <MudStack Row Spacing="1" Style="flex-wrap:wrap">
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.CalendarMonth">Fatura Dönemi: <b>@Period</b></MudChip>
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.CurrencyExchange"
                         Color="@(EurPricing.IsValidRate(Claim?.EurRate) ? Color.Info : Color.Warning)">
                    @(EurPricing.IsValidRate(Claim?.EurRate) ? $"EUR Kuru: {EurPricing.FormatRate(Claim!.EurRate!.Value)} ₺" : "EUR kuru girilmedi")
                </MudChip>
                @if (Info is not null)
                {
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Inventory2">
                        Malzeme: <b>@Info.ItemCode</b> — @Info.Description · Fiyat: <b>@Info.UnitPrice.ToString("N2", Tr) ₺</b>
                    </MudChip>
                }
            </MudStack>

            @* Giriş alanı: bu forma ait bilgiler *@
            @if (Current is not null)
            {
                <MudPaper Elevation="2" Class="pa-2">
                    <MudText Typo="Typo.caption" Style="font-weight:600" Class="mb-1 d-block">
                        @(IsAdded(Current) ? "Satırı güncelle" : "Bu form için bilgileri girin") — @Current.OriginalFileName
                    </MudText>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" md="8">
                            <MudAutocomplete T="StoreDto" Value="@_store" ValueChanged="@(s => _store = s)"
                                             SearchFunc="@SearchStoresAsync"
                                             ToStringFunc="@(s => s is null ? string.Empty : $"{s.Code} — {s.Name}")"
                                             Label="Mağaza *" Variant="Variant.Outlined" Margin="Margin.Dense" Dense Clearable ResetValueOnEmptyText
                                             MinCharacters="1" MaxItems="30" Placeholder="Kod veya ad yazın" />
                        </MudItem>
                        <MudItem xs="12" md="4" Class="d-flex align-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Format:&nbsp;</MudText>
                            @if (!string.IsNullOrWhiteSpace(_store?.Format))
                            {
                                <span style="color:#d32f2f;font-weight:700">@_store!.Format</span>
                            }
                            else { <span style="color:#9e9e9e">—</span> }
                        </MudItem>
                        <MudItem xs="6" md="4">
                            <MudDatePicker Date="@_date" DateChanged="@(d => _date = d)" Label="Tarih *"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Editable DateFormat="dd.MM.yyyy"
                                           Culture="@Tr" Placeholder="gg.aa.yyyy" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudTextField T="string" @bind-Value="_formNo" Label="Form No *" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" MaxLength="50" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudNumericField T="decimal?" @bind-Value="_qty" Label="Miktar *" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Min="0" Culture="@Tr" Format="0.##" HideSpinButtons />
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Size="Size.Medium" Disabled="@_saving"
                                       StartIcon="@(IsAdded(Current) ? Icons.Material.Filled.Save : Icons.Material.Filled.Add)"
                                       OnClick="AddAsync" Style="height:40px">
                                @(IsAdded(Current) ? "Güncelle" : "Ekle")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    @if (Info is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                            Toplam: <b>@EntryTotal.ToString("N2", Tr) ₺</b>
                        </MudText>
                    }
                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense Class="mt-1" Style="padding:2px 10px">@_error</MudAlert>
                    }
                </MudPaper>
            }

            @* Eklenen satırlar *@
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Eklenen Formlar (@AddedForms.Count / @AllForms.Count)</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SortByAlpha" OnClick="SortByStore" Disabled="@(AddedForms.Count < 2)">
                    Mağaza koduna göre diz
                </MudButton>
            </MudStack>
            <MudPaper Elevation="1" Style="overflow-x:auto">
                <MudSimpleTable Dense Hover Bordered Style="min-width:560px">
                    <thead>
                        <tr>
                            <th style="width:28px">#</th>
                            <th>Mağaza</th>
                            <th>Format</th>
                            <th>Tarih</th>
                            <th>Form No</th>
                            <th style="text-align:right">Miktar</th>
                            <th style="text-align:right">Toplam</th>
                            <th style="width:36px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (AddedForms.Count == 0)
                        {
                            <tr><td colspan="8"><MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">Henüz satır eklenmedi. Formu inceleyip yukarıdan bilgileri girin ve "Ekle"ye basın.</MudText></td></tr>
                        }
                        @{ int n = 0; }
                        @foreach (var f in AddedForms)
                        {
                            n++;
                            var item = GlycolItem(f);
                            <tr @key="f.Id" class="glycol-row @(Current?.Id == f.Id ? "glycol-row-current" : "")" @onclick="@(() => SelectFormAsync(f.Id))">
                                <td>@n</td>
                                <td><b>@f.StoreCode</b> — @f.StoreName</td>
                                <td><span style="color:#d32f2f;font-weight:700">@f.StoreFormat</span></td>
                                <td>@(f.FormDate?.ToString("dd.MM.yyyy"))</td>
                                <td>
                                    @f.FormNumber
                                    @if (IsDuplicateFormNo(f))
                                    {
                                        <MudTooltip Text="Bu form numarası başka bir satırda da var">
                                            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Error" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                </td>
                                <td style="text-align:right">@((item?.Quantity ?? 0m).ToString("0.##", Tr))</td>
                                <td style="text-align:right;font-weight:600">@RowTotal(f).ToString("N2", Tr) ₺</td>
                                <td>
                                    <span @onclick:stopPropagation>
                                        <MudTooltip Text="Satırı sil">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => ClearFormAsync(f.Id))" />
                                        </MudTooltip>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:700; background:#f1f8e9">
                            <td colspan="5" style="text-align:right">TOPLAM</td>
                            <td style="text-align:right">@AddedForms.Sum(f => GlycolItem(f)?.Quantity ?? 0m).ToString("0.##", Tr)</td>
                            <td style="text-align:right">@GrandTotal.ToString("N2", Tr) ₺</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            </MudPaper>

            @* Mağaza özeti (Excel'deki GENEL TOPLAM) — mağazanın tüm satırlarını silebilir *@
            @if (StoreSummaries.Count > 0)
            {
                <MudPaper Elevation="1" Class="pa-2">
                    <MudText Typo="Typo.caption" Style="font-weight:600" Class="mb-1 d-block">
                        Mağaza bazında özet <span style="font-weight:400;color:#757575">(Excel'deki GENEL TOPLAM)</span>
                    </MudText>
                    <MudSimpleTable Dense Hover>
                        <thead>
                            <tr><th>Kod</th><th>Mağaza Adı</th><th>Format</th><th style="text-align:right">Form</th><th style="text-align:right">Miktar</th><th style="text-align:right">Genel Toplam</th><th style="width:36px"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in StoreSummaries)
                            {
                                <tr>
                                    <td><b>@s.Code</b></td><td>@s.Name</td>
                                    <td><span style="color:#d32f2f;font-weight:700">@s.Format</span></td>
                                    <td style="text-align:right">@s.FormCount</td>
                                    <td style="text-align:right">@s.Qty.ToString("0.##", Tr)</td>
                                    <td style="text-align:right;font-weight:600">@s.Total.ToString("N2", Tr) ₺</td>
                                    <td>
                                        <MudTooltip Text="Bu mağazanın tüm satırlarını sil">
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => ClearStoreAsync(s))" />
                                        </MudTooltip>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }

            <MudStack Row Justify="Justify.SpaceBetween">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => OnBack.InvokeAsync())">
                    Form Yükleme
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" EndIcon="@Icons.Material.Filled.TableChart"
                           OnClick="@(() => OnExport.InvokeAsync())" Disabled="@(AddedForms.Count == 0)">
                    Excel Oluştur
                </MudButton>
            </MudStack>
        </MudStack>
    </MudItem>
</MudGrid>
</div>

@code {
    [Parameter] public List<ServiceFormDto> Forms { get; set; } = new();
    [Parameter] public ProgressClaimDto? Claim { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly CultureInfo Tr = CultureInfo.GetCultureInfo("tr-TR");

    private sealed record StoreSummary(string Code, string Name, string? Format, int FormCount, decimal Qty, decimal Total, List<int> FormIds);

    private List<StoreDto> _stores = new();
    private int _index;
    private int? _loadedFormId;
    /// <summary>Eklenen formların tabloda görünme sırası (ekleme sırası; "diz" ile yeniden sıralanır).</summary>
    private readonly List<int> _order = new();

    // giriş alanı
    private StoreDto? _store;
    private DateTime? _date;
    private string? _formNo;
    private decimal? _qty;
    private bool _saving;
    private string? _error;

    private string Period => GlycolClaim.PeriodName(Claim?.Month ?? 0);

    /// <summary>Servis formları, yüklenme sırasıyla.</summary>
    private List<ServiceFormDto> AllForms => Forms.Where(f => !string.IsNullOrEmpty(f.FilePath))
        .OrderBy(f => f.UploadedAt).ThenBy(f => f.Id).ToList();

    private ServiceFormDto? Current => _index >= 0 && _index < AllForms.Count ? AllForms[_index] : null;

    private static ServiceItemDto? GlycolItem(ServiceFormDto f) => f.ServiceItems.FirstOrDefault(i => i.ItemCode != null);

    /// <summary>Otomatik alanlar (malzeme kodu/adı, fiyat) için herhangi bir formdaki glikol kalemi.</summary>
    private ServiceItemDto? Info => Forms.Select(GlycolItem).FirstOrDefault(i => i is not null);

    private static bool IsAdded(ServiceFormDto f) => f.Status == ServiceFormStatus.Tamamlandi;

    private List<ServiceFormDto> AddedForms
    {
        get
        {
            var all = AllForms;
            return _order.Select(id => all.FirstOrDefault(f => f.Id == id)).Where(f => f is not null && IsAdded(f!)).Select(f => f!).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _stores = await StoreService.GetAllAsync();
        SyncOrder();
        var firstPending = AllForms.FindIndex(f => !IsAdded(f));
        _index = firstPending >= 0 ? firstPending : 0;
        LoadEntry();
    }

    protected override void OnParametersSet()
    {
        SyncOrder();
        if (_index >= AllForms.Count) _index = Math.Max(0, AllForms.Count - 1);
        if (Current?.Id != _loadedFormId) LoadEntry();
    }

    /// <summary>Tamamlanmış formlar tabloda olmalı: yeni olanlar sona eklenir, tamamlanmayanlar/silinenler çıkarılır.</summary>
    private void SyncOrder()
    {
        var all = AllForms;
        _order.RemoveAll(id => !all.Any(f => f.Id == id && IsAdded(f)));
        foreach (var f in all.Where(IsAdded).Where(f => !_order.Contains(f.Id)))
            _order.Add(f.Id);
    }

    private void LoadEntry()
    {
        var cur = Current;
        _loadedFormId = cur?.Id;
        _error = null;
        if (cur is null) { _store = null; _date = null; _formNo = null; _qty = null; return; }
        _store = cur.StoreId.HasValue ? (_stores.FirstOrDefault(s => s.Id == cur.StoreId.Value) ?? FromForm(cur)) : null;
        _date = cur.FormDate;
        _formNo = cur.FormNumber;
        var item = GlycolItem(cur);
        _qty = item is { Quantity: > 0m } ? item.Quantity : null;
    }

    private static StoreDto FromForm(ServiceFormDto f) => new()
    { Id = f.StoreId ?? 0, Code = f.StoreCode, Name = f.StoreName, Format = f.StoreFormat, Region = f.StoreRegion };

    // ── Gezinme ─────────────────────────────────────────────────────────
    private Task PreviousFormAsync() { if (_index > 0) { _index--; LoadEntry(); } return Task.CompletedTask; }
    private Task NextFormAsync() { if (_index < AllForms.Count - 1) { _index++; LoadEntry(); } return Task.CompletedTask; }

    private Task SelectFormAsync(int formId)
    {
        var idx = AllForms.FindIndex(f => f.Id == formId);
        if (idx >= 0) { _index = idx; LoadEntry(); }
        return Task.CompletedTask;
    }

    // ── Hesaplar ────────────────────────────────────────────────────────
    /// <summary>Satır toplamı: adet × EUR fiyatı × kur (yuvarlanmadan) — Excel'deki TOPLAM ile aynı.</summary>
    private static decimal RowTotal(ServiceFormDto f)
    {
        var item = GlycolItem(f);
        if (item is null) return 0m;
        return item.ForeignPrice.HasValue && item.ExchangeRate.HasValue
            ? item.Quantity * item.ForeignPrice.Value * item.ExchangeRate.Value
            : item.Quantity * item.UnitPrice;
    }

    private decimal EntryTotal
    {
        get
        {
            var info = Info;
            if (info is null || !(_qty > 0m)) return 0m;
            return info.ForeignPrice.HasValue && info.ExchangeRate.HasValue
                ? _qty.Value * info.ForeignPrice.Value * info.ExchangeRate.Value
                : _qty.Value * info.UnitPrice;
        }
    }

    private decimal GrandTotal => AddedForms.Sum(RowTotal);

    private List<StoreSummary> StoreSummaries => AddedForms
        .GroupBy(f => f.StoreCode)
        .Select(g => new StoreSummary(g.Key, g.First().StoreName, g.First().StoreFormat, g.Count(),
            g.Sum(x => GlycolItem(x)?.Quantity ?? 0m), g.Sum(RowTotal), g.Select(x => x.Id).ToList()))
        .OrderBy(s => s.Code, Comparer<string>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
        .ToList();

    private bool IsDuplicateFormNo(ServiceFormDto f)
        => !string.IsNullOrWhiteSpace(f.FormNumber)
           && AddedForms.Count(x => x.Id != f.Id && string.Equals(x.FormNumber?.Trim(), f.FormNumber.Trim(), StringComparison.OrdinalIgnoreCase)) > 0;

    // ── Mağaza araması ──────────────────────────────────────────────────
    private Task<IEnumerable<StoreDto>> SearchStoresAsync(string? text, CancellationToken ct)
    {
        var q = (text ?? string.Empty).Trim();
        if (q.Length == 0) return Task.FromResult<IEnumerable<StoreDto>>(_stores.Take(30).ToList());
        var found = _stores
            .Where(s => s.Code.StartsWith(q, StringComparison.OrdinalIgnoreCase)
                        || Tr.CompareInfo.IndexOf(s.Name, q, CompareOptions.IgnoreCase) >= 0)
            .OrderBy(s => s.Code.Equals(q, StringComparison.OrdinalIgnoreCase) ? 0 : s.Code.StartsWith(q, StringComparison.OrdinalIgnoreCase) ? 1 : 2)
            .ThenBy(s => s.Code, Comparer<string>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
            .Take(30)
            .ToList();
        return Task.FromResult<IEnumerable<StoreDto>>(found);
    }

    // ── Ekle / Güncelle ─────────────────────────────────────────────────
    private string MissingText()
    {
        var m = new List<string>();
        if (_store is null) m.Add("mağaza");
        if (!_date.HasValue) m.Add("tarih");
        if (string.IsNullOrWhiteSpace(_formNo)) m.Add("form no");
        if (!(_qty > 0m)) m.Add("miktar");
        return string.Join(", ", m);
    }

    private async Task AddAsync()
    {
        var cur = Current;
        if (cur is null || _saving) return;
        var missing = MissingText();
        if (missing.Length > 0) { _error = $"Eksik alan: {missing}"; return; }
        _error = null;

        // Aynı form numarası başka bir satırda varsa uyar (engellemez)
        var duplicate = AddedForms.Any(x => x.Id != cur.Id && string.Equals(x.FormNumber?.Trim(), _formNo!.Trim(), StringComparison.OrdinalIgnoreCase));

        _saving = true;
        try
        {
            var wasAdded = IsAdded(cur);
            var saved = await FormService.SaveGlycolRowAsync(cur.Id, _store!.Id, _date, _formNo, _qty!.Value);
            ReplaceForm(saved);
            if (!_order.Contains(saved.Id)) _order.Add(saved.Id);
            if (duplicate) Snackbar.Add($"Dikkat: \"{_formNo!.Trim()}\" form numarası başka bir satırda da var.", Severity.Warning);

            // Sıradaki bekleyen forma geç (yoksa mevcutta kal)
            var all = AllForms;
            var next = FindNextPending(all, all.FindIndex(f => f.Id == saved.Id));
            if (next >= 0) { _index = next; LoadEntry(); }
            else
            {
                _index = all.FindIndex(f => f.Id == saved.Id);
                LoadEntry();
                if (!wasAdded) Snackbar.Add("Tüm formlar eklendi.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"Kaydedilemedi: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
        await OnChanged.InvokeAsync();
    }

    private static int FindNextPending(List<ServiceFormDto> all, int from)
    {
        for (int i = 1; i <= all.Count; i++)
        {
            var idx = (from + i) % all.Count;
            if (!IsAdded(all[idx])) return idx;
        }
        return -1;
    }

    private void ReplaceForm(ServiceFormDto saved)
    {
        var idx = Forms.FindIndex(f => f.Id == saved.Id);
        if (idx >= 0) Forms[idx] = saved;
    }

    // ── Silme ───────────────────────────────────────────────────────────
    private async Task ClearFormAsync(int formId)
    {
        try
        {
            var cleared = await FormService.ClearGlycolRowAsync(formId);
            ReplaceForm(cleared);
            _order.Remove(formId);
            if (Current?.Id == formId) LoadEntry();
        }
        catch (Exception ex) { Snackbar.Add($"Silinemedi: {ex.Message}", Severity.Error); }
        await OnChanged.InvokeAsync();
    }

    private async Task ClearStoreAsync(StoreSummary summary)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Mağaza satırlarını sil",
            $"{summary.Code} — {summary.Name} mağazasının {summary.FormCount} satırı tablodan silinsin mi?\n(Servis formu dosyaları silinmez; formlar yeniden doldurulabilir.)",
            yesText: "Evet, sil", cancelText: "İptal");
        if (confirm != true) return;
        foreach (var id in summary.FormIds) await ClearFormAsync(id);
    }

    // ── Sıralama: önce mağaza kodu, aynı mağazada tarih ────────────────────
    private void SortByStore()
    {
        var sorted = AddedForms
            .OrderBy(f => f.StoreCode, Comparer<string>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
            .ThenBy(f => f.FormDate ?? DateTime.MaxValue)
            .ThenBy(f => f.FormNumber, Comparer<string?>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
            .ThenBy(f => f.Id)
            .Select(f => f.Id)
            .ToList();
        _order.Clear();
        _order.AddRange(sorted);
    }
}
