@namespace HakedisOtomasyon.Web.Components
@using System.Globalization
@using HakedisOtomasyon.Application
@using HakedisOtomasyon.Domain.Enums
@inject IServiceFormService FormService
@inject IStoreService StoreService
@inject IPriceListService PriceListService
@inject ISnackbar Snackbar

@* Soğutma — Glikol Kullanım ve Gaz Kullanım hakedişleri, tek ekran (ikisi AYNI; Gaz'da ek olarak satırın gaz türü seçilir —
   R22, R404, R407C, R410A, R134a ... fiyat listesindeki "SOĞUTUCU GAZ" kalemleri; seçim Ekle'den sonra yerinde kalır):
   SOL : yüklenen servis formu (PDF/görsel) her zaman açık; birden çok dosya varsa dosyalar arasında gezinilir.
   SAĞ : tek giriş alanı (mağaza, tarih, form no, miktar) → "Ekle" ile alt tabloya satır eklenir ve giriş alanı TEMİZLENİR;
         aynı dosyadan (örn. çok sayfalı PDF) istenen sayıda kayıt girilebilir. Glikol kalemi otomatik, servis ücreti yok.
   Satır silinebilir; "Mağaza koduna göre diz": önce mağaza kodu, aynı mağazada tarih. *@

<style>
    .glycol-compact { font-size: 12px; }
    .glycol-compact .glycol-table table { table-layout: auto; width: 100%; }
    .glycol-compact .glycol-table th,
    .glycol-compact .glycol-table td { font-size: 12px !important; padding: 2px 8px !important; white-space: nowrap; line-height: 1.35; height: 28px; }
    .glycol-compact .glycol-table th { font-size: 10.5px !important; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: #546e7a; background: #f5f7f8; }
    .glycol-compact .glycol-table td.num, .glycol-compact .glycol-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
    .glycol-compact .glycol-table td.store { max-width: 230px; overflow: hidden; text-overflow: ellipsis; }
    .glycol-compact .glycol-table tfoot td { font-weight: 700; background: #f1f8e9; border-top: 2px solid #c5e1a5; }
    .glycol-compact tr.glycol-row { cursor: pointer; }
    .glycol-compact tr.glycol-row-current td { background: #e3f2fd; }
</style>

<div class="glycol-compact">
<MudGrid Spacing="2">

    @* ───────── SOL: servis formu (daima açık) ───────── *@
    <MudItem xs="12" md="5">
        @if (CurrentFile is not null)
        {
            <PdfViewer @key="CurrentFile.FilePath" FileUrl="@CurrentFile.FileUrl" FileName="@CurrentFile.FileName" FilePath="@CurrentFile.FilePath" />
            <MudPaper Elevation="1" Class="pa-1 mt-2">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" Size="Size.Small" OnClick="PreviousFileAsync" Disabled="@(_fileIndex <= 0)" />
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2">Dosya @(_fileIndex + 1) / @Files.Count</MudText>
                        @{ var cnt = EntryCount(CurrentFile); }
                        <MudChip T="string" Size="Size.Small" Color="@(cnt > 0 ? Color.Success : Color.Warning)"
                                 Icon="@(cnt > 0 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.WarningAmber)">
                            @(cnt > 0 ? $"{cnt} kayıt eklendi" : "kayıt yok")
                        </MudChip>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" Size="Size.Small" OnClick="NextFileAsync" Disabled="@(_fileIndex >= Files.Count - 1)" />
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center justify-center" Style="min-height:240px">
                <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mt-2" Align="Align.Center">Henüz servis formu yüklenmedi. Önceki adımdan formları yükleyin.</MudText>
            </MudPaper>
        }
    </MudItem>

    @* ───────── SAĞ: giriş alanı + tablo + özet ───────── *@
    <MudItem xs="12" md="7">
        <MudStack Spacing="2">

            @* Otomatik bilgiler *@
            <MudStack Row Spacing="1" Style="flex-wrap:wrap">
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.CalendarMonth">Fatura Dönemi: <b>@Period</b></MudChip>
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.CurrencyExchange"
                         Color="@(EurPricing.IsValidRate(Claim?.EurRate) ? Color.Info : Color.Warning)">
                    @(EurPricing.IsValidRate(Claim?.EurRate) ? $"EUR Kuru: {EurPricing.FormatRate(Claim!.EurRate!.Value)} ₺" : "EUR kuru girilmedi")
                </MudChip>
                @if (IsGas)
                {
                    @if (_gas is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Inventory2">
                            Malzeme: <b>@_gas.PozNo</b> — @_gas.Description · Fiyat: <b>@GasUnitPriceTl(_gas).ToString("N2", Tr) ₺</b>
                        </MudChip>
                    }
                }
                else if (Info is not null)
                {
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Inventory2">
                        Malzeme: <b>@Info.ItemCode</b> — @Info.Description · Fiyat: <b>@Info.UnitPrice.ToString("N2", Tr) ₺</b>
                    </MudChip>
                }
            </MudStack>

            @* Giriş alanı: her "Ekle"den sonra temizlenir *@
            @if (CurrentFile is not null)
            {
                <MudPaper Elevation="2" Class="pa-3">
                    <MudText Typo="Typo.caption" Style="font-weight:600" Class="mb-2 d-block">
                        @(_editingId.HasValue ? "Kaydı güncelle" : "Yeni kayıt") — @CurrentFile.FileName
                    </MudText>
                    @if (IsGas)
                    {
                        @* Gaz türü: satırın kalemi. Ekle'den sonra TEMİZLENMEZ (art arda aynı gaz girilir); değiştirilebilir. *@
                        <MudSelect T="PriceItemDto" Value="@_gas" ValueChanged="@(g => _gas = g)" Label="Gaz türü *"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense Class="mb-2"
                                   ToStringFunc="@(g => g is null ? string.Empty : GasText(g))"
                                   Placeholder="@(_gasItems.Count == 0 ? "Fiyat listesinde soğutucu gaz kalemi yok" : "Seçin")">
                            @foreach (var g in _gasItems)
                            {
                                <MudSelectItem T="PriceItemDto" Value="@g">@GasText(g) · @GasUnitPriceTl(g).ToString("N2", Tr) ₺/@(string.IsNullOrWhiteSpace(g.Unit) ? "kg" : g.Unit)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <div @key="@($"kayit-{_entryKey}")">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="9">
                                <MudAutocomplete T="StoreDto" Value="@_store" ValueChanged="@(s => _store = s)"
                                                 SearchFunc="@SearchStoresAsync"
                                                 ToStringFunc="@(s => s is null ? string.Empty : $"{s.Code} — {s.Name}")"
                                                 Label="Mağaza *" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable ResetValueOnEmptyText
                                                 MinCharacters="1" MaxItems="30" Placeholder="Kod veya ad yazın" />
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Format:&nbsp;</MudText>
                                @if (!string.IsNullOrWhiteSpace(_store?.Format))
                                {
                                    <span style="color:#d32f2f;font-weight:700">@_store!.Format</span>
                                }
                                else { <span style="color:#9e9e9e">—</span> }
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudDatePicker Date="@_date" DateChanged="@(d => _date = d)" Label="Tarih *"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Editable DateFormat="dd.MM.yyyy"
                                               Culture="@Tr" Placeholder="gg.aa.yyyy" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudTextField T="string" @bind-Value="_formNo" Label="Form No *" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField T="decimal?" @bind-Value="_qty" Label="Miktar *" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="0" Culture="@Tr" Format="0.##" HideSpinButtons />
                            </MudItem>
                        </MudGrid>
                    </div>
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @if (EntryTotal > 0m) { <span>Toplam: <b>@EntryTotal.ToString("N2", Tr) ₺</b></span> }
                        </MudText>
                        <MudStack Row Spacing="1">
                            @if (_editingId.HasValue)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearEntry">Yeni kayıt</MudButton>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@_saving"
                                       StartIcon="@(_editingId.HasValue ? Icons.Material.Filled.Save : Icons.Material.Filled.Add)"
                                       OnClick="AddAsync">
                                @(_editingId.HasValue ? "Güncelle" : "Ekle")
                            </MudButton>
                        </MudStack>
                    </MudStack>
                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense Class="mt-1" Style="padding:2px 10px">@_error</MudAlert>
                    }
                </MudPaper>
            }

            @* Eklenen kayıtlar *@
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Eklenen Formlar (@AddedForms.Count)</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SortByAlpha" OnClick="SortByStore" Disabled="@(AddedForms.Count < 2)">
                    Mağaza koduna göre diz
                </MudButton>
            </MudStack>
            <MudPaper Elevation="1" Style="overflow-x:auto">
                <MudSimpleTable Dense Hover Class="glycol-table" Style="min-width:520px">
                    <thead>
                        <tr>
                            <th style="width:26px">#</th>
                            <th>Mağaza</th>
                            <th>Fmt</th>
                            <th>Tarih</th>
                            <th>Form No</th>
                            @if (IsGas) { <th>Gaz</th> }
                            <th class="num">Miktar</th>
                            <th class="num">Toplam</th>
                            <th style="width:30px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (AddedForms.Count == 0)
                        {
                            <tr><td colspan="@(IsGas ? 9 : 8)" style="white-space:normal"><MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">Henüz satır eklenmedi. Formu inceleyip yukarıdan bilgileri girin ve "Ekle"ye basın.</MudText></td></tr>
                        }
                        @{ int n = 0; }
                        @foreach (var f in AddedForms)
                        {
                            n++;
                            var item = GlycolItem(f);
                            <tr @key="f.Id" class="glycol-row @(_editingId == f.Id ? "glycol-row-current" : "")" @onclick="@(() => EditEntryAsync(f.Id))">
                                <td style="color:#90a4ae">@n</td>
                                <td class="store" title="@f.StoreCode — @f.StoreName"><b>@f.StoreCode</b>&nbsp;<span style="color:#455a64">@f.StoreName</span></td>
                                <td><span style="color:#d32f2f;font-weight:700">@f.StoreFormat</span></td>
                                <td>@(f.FormDate?.ToString("dd.MM.yyyy"))</td>
                                <td>
                                    @f.FormNumber
                                    @if (IsDuplicateFormNo(f))
                                    {
                                        <MudTooltip Text="Bu form numarası başka bir satırda da var">
                                            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Error" Style="font-size:13px;vertical-align:middle" />
                                        </MudTooltip>
                                    }
                                </td>
                                @if (IsGas)
                                {
                                    <td title="@item?.Description"><b>@item?.ItemCode</b>&nbsp;@GasShortName(item?.Description)</td>
                                }
                                <td class="num">@((item?.Quantity ?? 0m).ToString("0.##", Tr))</td>
                                <td class="num" style="font-weight:600">@RowTotal(f).ToString("N2", Tr)&nbsp;₺</td>
                                <td style="padding:0 !important">
                                    <span @onclick:stopPropagation>
                                        <MudTooltip Text="Satırı sil">
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                           Style="padding:2px" OnClick="@(() => RemoveEntryAsync(f.Id))" />
                                        </MudTooltip>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="@(IsGas ? 6 : 5)" class="num">TOPLAM</td>
                            <td class="num">@AddedForms.Sum(f => GlycolItem(f)?.Quantity ?? 0m).ToString("0.##", Tr)</td>
                            <td class="num">@GrandTotal.ToString("N2", Tr)&nbsp;₺</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            </MudPaper>

            <MudStack Row Justify="Justify.SpaceBetween">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => OnBack.InvokeAsync())">
                    Form Yükleme
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" EndIcon="@Icons.Material.Filled.TableChart"
                           OnClick="@(() => OnExport.InvokeAsync())" Disabled="@(AddedForms.Count == 0)">
                    Excel Oluştur
                </MudButton>
            </MudStack>
        </MudStack>
    </MudItem>
</MudGrid>
</div>

@code {
    [Parameter] public List<ServiceFormDto> Forms { get; set; } = new();
    [Parameter] public ProgressClaimDto? Claim { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly CultureInfo Tr = CultureInfo.GetCultureInfo("tr-TR");

    private sealed record FileRef(string FilePath, string FileName, string FileUrl, int FirstFormId);

    private List<StoreDto> _stores = new();
    private int _fileIndex;
    /// <summary>Eklenen kayıtların tabloda görünme sırası (ekleme sırası; "diz" ile yeniden sıralanır).</summary>
    private readonly List<int> _order = new();

    // giriş alanı (her Ekle'den sonra temizlenir)
    private int? _editingId;
    private int _entryKey;
    private StoreDto? _store;
    private DateTime? _date;
    private string? _formNo;
    private decimal? _qty;
    private bool _saving;
    private string? _error;

    private string Period => GlycolClaim.PeriodName(Claim?.Month ?? 0);

    // ── Gaz Kullanım: satırın gaz türü (fiyat listesindeki "SOĞUTUCU GAZ" kalemleri) ──────────────
    private bool IsGas => Claim is not null && GlycolClaim.IsGas(Claim.Discipline, Claim.CoolingCategory);
    private List<PriceItemDto> _gasItems = new();
    /// <summary>Seçili gaz türü. Ekle'den sonra temizlenmez — art arda aynı gaz girilebilsin.</summary>
    private PriceItemDto? _gas;

    private static string GasShortName(string? description)
    {
        var d = (description ?? string.Empty).Trim();
        var i = d.LastIndexOf(' ');
        return i >= 0 ? d[(i + 1)..] : d;   // "SOĞUTUCU GAZ 10,9 KG TÜP (kg fiyatı) R404" → "R404"
    }

    private static string GasText(PriceItemDto g) => $"{g.PozNo} — {GasShortName(g.Description)} ({g.Description})";

    /// <summary>Gazın TL birim fiyatı: EUR fiyatı × hakediş EUR kuru (yuvarlanmadan); TL fiyatlıysa birim fiyat.</summary>
    private decimal GasUnitPriceTl(PriceItemDto g)
        => g.ForeignPrice is > 0m && EurPricing.IsEur(g.CurrencyCode)
            ? (EurPricing.IsValidRate(Claim?.EurRate) ? g.ForeignPrice.Value * Claim!.EurRate!.Value : 0m)
            : g.UnitPrice;

    /// <summary>Yüklenen dosyalar (yüklenme sırasıyla). Bir dosyadan birden çok kayıt girilebildiği için kayıtlar dosya yoluna göre gruplanır.</summary>
    private List<FileRef> Files => Forms
        .Where(f => !string.IsNullOrEmpty(f.FilePath))
        .GroupBy(f => f.FilePath)
        .Select(g => g.OrderBy(x => x.UploadedAt).ThenBy(x => x.Id).First())
        .OrderBy(f => f.UploadedAt).ThenBy(f => f.Id)
        .Select(f => new FileRef(f.FilePath, f.OriginalFileName, f.FileUrl, f.Id))
        .ToList();

    private FileRef? CurrentFile { get { var files = Files; return _fileIndex >= 0 && _fileIndex < files.Count ? files[_fileIndex] : null; } }

    private int EntryCount(FileRef file) => Forms.Count(f => f.FilePath == file.FilePath && IsAdded(f));

    private static ServiceItemDto? GlycolItem(ServiceFormDto f) => f.ServiceItems.FirstOrDefault(i => i.ItemCode != null);

    /// <summary>Otomatik alanlar (malzeme kodu/adı, fiyat) için herhangi bir kaydın glikol kalemi.</summary>
    private ServiceItemDto? Info => Forms.Select(GlycolItem).FirstOrDefault(i => i is not null);

    private static bool IsAdded(ServiceFormDto f) => f.Status == ServiceFormStatus.Tamamlandi;

    private List<ServiceFormDto> AddedForms
    {
        get
        {
            var byId = Forms.ToDictionary(f => f.Id);
            return _order.Where(id => byId.TryGetValue(id, out var f) && IsAdded(f)).Select(id => byId[id]).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _stores = await StoreService.GetAllAsync();
        if (IsGas)
        {
            _gasItems = (await PriceListService.GetAllAsync())
                .Where(p => GlycolClaim.IsGasPriceName(p.Description))
                .OrderBy(p => p.PozNo, Comparer<string?>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
                .ToList();
        }
        SyncOrder();
        var files = Files;
        var firstEmpty = files.FindIndex(f => EntryCount(f) == 0);
        _fileIndex = firstEmpty >= 0 ? firstEmpty : 0;
        ClearEntry();
    }

    protected override void OnParametersSet()
    {
        SyncOrder();
        var count = Files.Count;
        if (_fileIndex >= count) _fileIndex = Math.Max(0, count - 1);
    }

    /// <summary>Tamamlanmış kayıtlar tabloda olmalı: yenileri sona eklenir, tamamlanmayanlar/silinenler çıkarılır.</summary>
    private void SyncOrder()
    {
        _order.RemoveAll(id => !Forms.Any(f => f.Id == id && IsAdded(f)));
        foreach (var f in Forms.Where(IsAdded).OrderBy(f => f.Id).Where(f => !_order.Contains(f.Id)))
            _order.Add(f.Id);
    }

    private static StoreDto FromForm(ServiceFormDto f) => new()
    { Id = f.StoreId ?? 0, Code = f.StoreCode, Name = f.StoreName, Format = f.StoreFormat, Region = f.StoreRegion };

    // ── Giriş alanı ─────────────────────────────────────────────────────
    private void ClearEntry()
    {
        _editingId = null;
        _store = null; _date = null; _formNo = null; _qty = null;
        _error = null;
        _entryKey++;   // alanları (özellikle mağaza arama kutusunu) baştan kur → görünen metin de temizlenir
    }

    private Task EditEntryAsync(int formId)
    {
        var f = Forms.FirstOrDefault(x => x.Id == formId);
        if (f is null) return Task.CompletedTask;
        var idx = Files.FindIndex(x => x.FilePath == f.FilePath);
        if (idx >= 0) _fileIndex = idx;               // formu sol panelde aç
        _editingId = f.Id;
        _store = f.StoreId.HasValue ? (_stores.FirstOrDefault(s => s.Id == f.StoreId.Value) ?? FromForm(f)) : null;
        _date = f.FormDate;
        _formNo = f.FormNumber;
        var item = GlycolItem(f);
        _qty = item is { Quantity: > 0m } ? item.Quantity : null;
        if (IsGas) _gas = _gasItems.FirstOrDefault(g => g.PozNo == item?.ItemCode) ?? _gas;   // satırın gaz türü
        _error = null;
        _entryKey++;
        return Task.CompletedTask;
    }

    // ── Dosya gezinmesi ─────────────────────────────────────────────────
    private Task PreviousFileAsync() { if (_fileIndex > 0) { _fileIndex--; ClearEntry(); } return Task.CompletedTask; }
    private Task NextFileAsync() { if (_fileIndex < Files.Count - 1) { _fileIndex++; ClearEntry(); } return Task.CompletedTask; }

    // ── Hesaplar ────────────────────────────────────────────────────────
    /// <summary>Satır toplamı: adet × EUR fiyatı × kur (yuvarlanmadan) — Excel'deki TOPLAM ile aynı.</summary>
    private static decimal RowTotal(ServiceFormDto f)
    {
        var item = GlycolItem(f);
        if (item is null) return 0m;
        return item.ForeignPrice.HasValue && item.ExchangeRate.HasValue
            ? item.Quantity * item.ForeignPrice.Value * item.ExchangeRate.Value
            : item.Quantity * item.UnitPrice;
    }

    private decimal EntryTotal
    {
        get
        {
            if (IsGas) return _gas is not null && _qty > 0m ? _qty.Value * GasUnitPriceTl(_gas) : 0m;
            var info = Info;
            if (info is null || !(_qty > 0m)) return 0m;
            return info.ForeignPrice.HasValue && info.ExchangeRate.HasValue
                ? _qty.Value * info.ForeignPrice.Value * info.ExchangeRate.Value
                : _qty.Value * info.UnitPrice;
        }
    }

    private decimal GrandTotal => AddedForms.Sum(RowTotal);

    private bool IsDuplicateFormNo(ServiceFormDto f)
        => !string.IsNullOrWhiteSpace(f.FormNumber)
           && AddedForms.Count(x => x.Id != f.Id && string.Equals(x.FormNumber?.Trim(), f.FormNumber.Trim(), StringComparison.OrdinalIgnoreCase)) > 0;

    // ── Mağaza araması ──────────────────────────────────────────────────
    private Task<IEnumerable<StoreDto>> SearchStoresAsync(string? text, CancellationToken ct)
    {
        var q = (text ?? string.Empty).Trim();
        if (q.Length == 0) return Task.FromResult<IEnumerable<StoreDto>>(_stores.Take(30).ToList());
        var found = _stores
            .Where(s => s.Code.StartsWith(q, StringComparison.OrdinalIgnoreCase)
                        || Tr.CompareInfo.IndexOf(s.Name, q, CompareOptions.IgnoreCase) >= 0)
            .OrderBy(s => s.Code.Equals(q, StringComparison.OrdinalIgnoreCase) ? 0 : s.Code.StartsWith(q, StringComparison.OrdinalIgnoreCase) ? 1 : 2)
            .ThenBy(s => s.Code, Comparer<string>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
            .Take(30)
            .ToList();
        return Task.FromResult<IEnumerable<StoreDto>>(found);
    }

    // ── Ekle / Güncelle ─────────────────────────────────────────────────
    private string MissingText()
    {
        var m = new List<string>();
        if (IsGas && _gas is null) m.Add("gaz türü");
        if (_store is null) m.Add("mağaza");
        if (!_date.HasValue) m.Add("tarih");
        if (string.IsNullOrWhiteSpace(_formNo)) m.Add("form no");
        if (!(_qty > 0m)) m.Add("miktar");
        return string.Join(", ", m);
    }

    private async Task AddAsync()
    {
        var file = CurrentFile;
        if (file is null || _saving) return;
        var missing = MissingText();
        if (missing.Length > 0) { _error = $"Eksik alan: {missing}"; return; }
        _error = null;

        // Aynı form numarası başka bir satırda varsa uyar (engellemez)
        var no = _formNo!.Trim();
        var duplicate = AddedForms.Any(x => x.Id != _editingId && string.Equals(x.FormNumber?.Trim(), no, StringComparison.OrdinalIgnoreCase));

        _saving = true;
        try
        {
            int? gasId = IsGas ? _gas!.Id : null;   // Glikol'de kalem otomatik; Gaz'da satırın gaz türü
            var saved = _editingId.HasValue
                ? await FormService.SaveGlycolRowAsync(_editingId.Value, _store!.Id, _date, no, _qty!.Value, gasId)
                : await FormService.AddGlycolEntryAsync(file.FirstFormId, _store!.Id, _date, no, _qty!.Value, gasId);
            UpsertForm(saved);
            if (!_order.Contains(saved.Id)) _order.Add(saved.Id);
            if (duplicate) Snackbar.Add($"Dikkat: \"{no}\" form numarası başka bir satırda da var.", Severity.Warning);

            ClearEntry();   // giriş alanı temizlenir — yeni kayıt girilebilir
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"Kaydedilemedi: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
        await OnChanged.InvokeAsync();
    }

    private void UpsertForm(ServiceFormDto saved)
    {
        var idx = Forms.FindIndex(f => f.Id == saved.Id);
        if (idx >= 0) Forms[idx] = saved; else Forms.Add(saved);
    }

    // ── Silme ───────────────────────────────────────────────────────────
    private async Task RemoveEntryAsync(int formId)
    {
        try
        {
            var result = await FormService.RemoveGlycolRowAsync(formId);
            if (result is null) Forms.RemoveAll(f => f.Id == formId); else UpsertForm(result);
            _order.Remove(formId);
            if (_editingId == formId) ClearEntry();
        }
        catch (Exception ex) { Snackbar.Add($"Silinemedi: {ex.Message}", Severity.Error); }
        await OnChanged.InvokeAsync();
    }

    // ── Sıralama: önce mağaza kodu, aynı mağazada tarih ────────────────────
    private void SortByStore()
    {
        var sorted = AddedForms
            .OrderBy(f => f.StoreCode, Comparer<string>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
            .ThenBy(f => f.FormDate ?? DateTime.MaxValue)
            .ThenBy(f => f.FormNumber, Comparer<string?>.Create((a, b) => GlycolClaim.CompareStoreCodes(a, b)))
            .ThenBy(f => f.Id)
            .Select(f => f.Id)
            .ToList();
        _order.Clear();
        _order.AddRange(sorted);
    }
}
