@using SogutmaHakedisKontrol.Application.DTOs
@using SogutmaHakedisKontrol.Application.Interfaces
@using SogutmaHakedisKontrol.Domain.Enums
@using StoreDto = SogutmaHakedisKontrol.Application.DTOs.StoreDto
@inject IAiAnalysisPipelineService Pipeline
@inject SogutmaHakedisKontrol.Application.Interfaces.IProgressPaymentCheckService CheckService
@inject IStoreMasterService StoreMasterService
@inject SogutmaHakedisKontrol.Application.Interfaces.IFilePickerService FilePicker
@inject IPdfPageRasterizer PdfRasterizer
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (_initError != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <MudText Typo="Typo.body2" Style="font-weight:600">HakedisKontrolWizard başlatılamadı</MudText>
        <MudText Typo="Typo.caption" Style="white-space:pre-wrap">@_initError</MudText>
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
        <div>
            <MudText Typo="Typo.subtitle1" Style="font-weight:700">Belge Kontrolu ve Yapay Zeka Analizi</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Servis ve periyodik bakim formlarindaki el yazisini okur, magazalari eslestirir ve hakedis satirlarini kontrol eder.
            </MudText>
        </div>
    </MudStack>

    <MudStepper @bind-ActiveIndex="_activeStep" NonLinear="false">

        <MudStep Title="Hakedis Excel" Completed="true">
            <MudPaper Class="pa-3" Outlined>
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        <div>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600">@_check?.OriginalFileName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Step1SummaryLine</MudText>
                        </div>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Hazir</MudChip>
                </MudStack>
            </MudPaper>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                Farkli bir hakedis dosyasi kontrol etmek isterseniz
                <MudLink Href="/discipline/sogutma/kontrol">Kontrol Merkezi'nden</MudLink> yeni bir kontrol baslatabilirsiniz.
            </MudText>
            <MudStack Row Justify="Justify.FlexEnd" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="GoToStep2">
                    Ileri
                </MudButton>
            </MudStack>
        </MudStep>

        <MudStep Title="Servis ve Bakim Formlari" Completed="@Step2Completed">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Hakediste bulunan islerin dogrulanabilmesi icin servis ve bakim formlarini ekleyin.
            </MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3" Outlined Style="height:100%">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600">Servis / Malzeme Formlari</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            Ariza, servis cagrisi ve kullanilan malzemelerin bulundugu servis formlari.
                            Tek PDF icerisinde birden fazla servis formu bulunabilir.
                        </MudText>

                        <FileDropZone OnFilesSelected="AddServiceFilesAsync" />

                        @foreach (var f in _serviceFiles)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1 mt-2">
                                <div>
                                    <MudText Typo="Typo.body2">@f.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="@FileStatusColor(f)">@FileStatusLabel(f)</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => RemoveServiceFile(f))" />
                            </MudStack>
                        }
                        @if (_serviceFiles.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Style="font-weight:600" Class="mt-1 d-block">@ServiceFormsTotalLine</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3" Outlined Style="height:100%">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.HomeRepairService" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600">Periyodik Bakim Formlari</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            Sogutma Agir Bakim / Periyodik Bakim formlari. Bu belgeler servis ucreti kontrolunde kullanilir.
                        </MudText>

                        @if (_noMaintenanceThisPeriod == false)
                        {
                            <FileDropZone OnFilesSelected="SetMaintenanceFileAsync" />
                        }
                        @if (_maintenanceFile != null && _noMaintenanceThisPeriod == false)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
                                <div>
                                    <MudText Typo="Typo.body2">@_maintenanceFile.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="@FileStatusColor(_maintenanceFile)">@FileStatusLabel(_maintenanceFile)</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="RemoveMaintenanceFile" />
                            </MudStack>
                        }
                        <MudCheckBox T="bool" @bind-Value="_noMaintenanceThisPeriod" Color="Color.Primary" Class="mt-2"
                                     Label="Bu donem periyodik bakim formu bulunmuyor" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_serviceFiles.Count > 0)
            {
                <MudPaper Class="pa-3 mt-3" Outlined>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600" Class="mb-2">Analize Hazir Belgeler</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="4"><KpiStat Label="Hakedis Excel" Value="1 dosya" /></MudItem>
                        <MudItem xs="4"><KpiStat Label="Servis Formlari" Value="@ServiceFormsPageSummary" /></MudItem>
                        <MudItem xs="4"><KpiStat Label="Periyodik Bakim" Value="@MaintenanceSummary" /></MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <MudStack Row Justify="Justify.SpaceBetween" Class="mt-3">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToStep1">Geri</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="@(!CanProceedToAnalysis)" OnClick="GoToStep3">
                    Ileri
                </MudButton>
            </MudStack>
        </MudStep>

        <MudStep Title="AI Analizi" Completed="@Step3Completed" Disabled="@(!CanProceedToAnalysis)" HasError="@Step3HasError">
            @if (_running)
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="8">
                        <MudPaper Class="pa-4" Outlined>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600" Class="mb-2">Hakedis Analizi Devam Ediyor</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">@_progressMessage</MudText>
                            @if (_progressTotal.HasValue && _progressTotal.Value > 0)
                            {
                                <MudProgressLinear Value="@ProgressPercent" Color="Color.Primary" Class="mb-1" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ProgressCounterLabel</MudText>
                            }
                            else
                            {
                                <MudProgressLinear Indeterminate Color="Color.Primary" />
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-3" Outlined>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:600" Class="mb-2">Canli Ozet</MudText>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption">Analiz Edilen</MudText>
                                <MudText Typo="Typo.caption" Style="font-weight:600">@ProgressCounterLabel</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudText Typo="Typo.subtitle1" Style="font-weight:600" Class="mb-1">Yapay Zeka ile Hakedisi Kontrol Edin</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    GPT-5.5 servis formlarindaki el yazilarini okuyacak, magazalari eslestirecek ve hakedis satirlarini kontrol edecektir.
                </MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="7">
                        <MudPaper Class="pa-3" Outlined>
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="@OpenAiStatusColor" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight:600">OpenAI</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Model: GPT-5.5</MudText>
                                    </div>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="@OpenAiStatusColor">@OpenAiStatusLabel</MudChip>
                            </MudStack>
                        </MudPaper>

                        @if (_storeCount == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense Class="mt-3">
                                Magaza listesi yuklenmeden magaza tespiti guvenilir yapilamaz.
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenStoreImportDialog">Magaza Listesi Yukle</MudButton>
                            </MudAlert>
                        }
                        @if (_openAiConfigured == false)
                        {
                            <MudAlert Severity="Severity.Error" Dense Class="mt-3">
                                OpenAI API anahtari yapilandirilmamis. Kontrol calistirilamaz.
                            </MudAlert>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   Disabled="@AnalyzeButtonDisabled"
                                   OnClick="RunAnalysisAsync">
                            Yapay Zeka ile Kontrol Et
                        </MudButton>
                        @if (_job != null)
                        {
                            <MudButton Variant="Variant.Text" Class="mt-1" FullWidth OnClick="RetryFailedAsync" Disabled="@RetryButtonDisabled">
                                @RetryButtonLabel
                            </MudButton>
                        }
                    </MudItem>
                </MudGrid>

                <MudStack Row Justify="Justify.SpaceBetween" Class="mt-3">
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToStep2">Geri</MudButton>
                    @if (_job != null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="GoToStep4">
                            Sonuclari Gor
                        </MudButton>
                    }
                </MudStack>
            }
        </MudStep>

        <MudStep Title="Sonuclar" Disabled="@(_job == null)" Completed="@Step4Completed">
            @if (_job == null)
            {
                <MudAlert Severity="Severity.Info" Dense>Henuz bir analiz calistirilmadi.</MudAlert>
            }
            else
            {
                <MudGrid Spacing="1" Class="mb-3">
                    <MudItem xs="6" md="2"><KpiStat Label="Toplam Kontrol" Value="@TotalResultsLabel" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Uygun" Value="@UygunCountLabel" Color="Color.Success" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Uygun Degil" Value="@UygunDegilCountLabel" Color="Color.Error" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Manuel Kontrol" Value="@ManuelKontrolCountLabel" Color="Color.Warning" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Eksik / Fazla" Value="@EksikFazlaCountLabel" Color="Color.Warning" /></MudItem>
                </MudGrid>

                <MudGrid Spacing="1" Class="mb-3">
                    <MudItem xs="6" md="2"><KpiStat Label="Servis Formu (AI)" Value="@ServiceFormPageCountLabel" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Bakim Formu (AI)" Value="@MaintenancePageCountLabel" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Icmal / Ozet Sayfasi" Value="@SummaryPageCountLabel" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Siniflandirilamadi" Value="@UnknownPageCountLabel" Color="@UnknownPageColor" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Eslesen Magaza" Value="@MatchedStoreCountLabel" Color="Color.Success" /></MudItem>
                    <MudItem xs="6" md="2"><KpiStat Label="Reddedilen Servis Ucreti" Value="@RejectedServiceFeeCountLabel" Color="Color.Error" /></MudItem>
                </MudGrid>

                @if (_manualReviewPages.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        <MudText Typo="Typo.body2" Style="font-weight:600" Class="mb-1">@ManualReviewHeaderLabel</MudText>
                        @foreach (var p in _manualReviewPages)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                <MudText Typo="Typo.caption">@ManualReviewPageLabel(p)</MudText>
                                @if (p.MatchedStoreId is null)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CorrectStoreAsync(p))">Magazayi Sec</MudButton>
                                }
                            </MudStack>
                            @foreach (var m in ManualReviewMaterials(p))
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="ml-4 mb-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ManualReviewMaterialLabel(m)</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CorrectMaterialAsync(m))">Duzelt</MudButton>
                                </MudStack>
                            }
                        }
                    </MudAlert>
                }

                <MudPaper Elevation="1" Style="overflow-x:auto;max-width:100%">
                    <MudTable Items="@_results" Dense Hover Filter="@TableFilter" RowsPerPage="25">
                        <ToolBarContent>
                            <MudGrid Spacing="1" AlignItems="AlignItems.Center">
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="_searchText" Placeholder="Magaza veya kalem ara..."
                                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                                  Immediate Dense Clearable Variant="Variant.Outlined" Class="mt-0" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                                                SelectedValue="_statusFilter" SelectedValueChanged="OnStatusFilterChanged"
                                                Style="flex-wrap:wrap">
                                        <MudChip T="string" Value="@AllFilterValue" Size="Size.Small">Tumu</MudChip>
                                        <MudChip T="string" Value="@UygunFilterValue" Size="Size.Small" Color="Color.Success">Uygun</MudChip>
                                        <MudChip T="string" Value="@UygunDegilFilterValue" Size="Size.Small" Color="Color.Error">Uygun Degil</MudChip>
                                        <MudChip T="string" Value="@EksikFilterValue" Size="Size.Small" Color="Color.Warning">Eksik</MudChip>
                                        <MudChip T="string" Value="@FazlaFilterValue" Size="Size.Small" Color="Color.Warning">Fazla</MudChip>
                                        <MudChip T="string" Value="@ManuelKontrolFilterValue" Size="Size.Small" Color="Color.Warning">Manuel Kontrol</MudChip>
                                    </MudChipSet>
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudSwitch T="bool" @bind-Value="_onlyProblems" Color="Color.Error" Label="Sadece Sorunlulari Goster" />
                                </MudItem>
                            </MudGrid>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Magaza</MudTh>
                            <MudTh>Tarih</MudTh>
                            <MudTh>Belge</MudTh>
                            <MudTh>Kontrol Kalemi</MudTh>
                            <MudTh>Form Degeri</MudTh>
                            <MudTh>Hakedis Degeri</MudTh>
                            <MudTh>Sonuc</MudTh>
                            <MudTh>Aciklama</MudTh>
                            <MudTh>Islem</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.StoreLabel</MudTd>
                            <MudTd>@VisitDateLabel(context)</MudTd>
                            <MudTd>@FormReferenceLabel(context)</MudTd>
                            <MudTd>@context.Description</MudTd>
                            <MudTd>@context.FormValue</MudTd>
                            <MudTd>@context.HakedisValue</MudTd>
                            <MudTd><MudChip T="string" Size="Size.Small" Color="@ResultColor(context.Status)">@ResultLabel(context.Status)</MudChip></MudTd>
                            <MudTd>
                                <MudTooltip Text="@context.Explanation">
                                    <MudText Typo="Typo.caption" Style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                                        @context.Explanation
                                    </MudText>
                                </MudTooltip>
                            </MudTd>
                            <MudTd>@EmptyActionLabel</MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager /></PagerContent>
                        <NoRecordsContent><MudAlert Severity="Severity.Info" Dense>Kayit yok.</MudAlert></NoRecordsContent>
                    </MudTable>
                </MudPaper>

                <MudStack Row Justify="Justify.SpaceBetween" Class="mt-3">
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToStep3">Geri</MudButton>
                </MudStack>
            }
        </MudStep>

    </MudStepper>
</MudPaper>

@code {
    [Parameter] public int CheckId { get; set; }
    [Parameter] public string CompanyName { get; set; } = string.Empty;
    [Parameter] public string CompanyRegion { get; set; } = string.Empty;

    private int _activeStep;
    private ProgressPaymentCheckDto? _check;
    private string? _fileSizeLabel;

    private List<PickedFile> _serviceFiles = new();
    private PickedFile? _maintenanceFile;
    private bool _noMaintenanceThisPeriod;

    private int _storeCount;
    private bool _openAiConfigured = true;

    private AiAnalysisJobDto? _job;
    private List<AiDocumentPageDto> _pages = new();
    private List<AiDocumentPageDto> _manualReviewPages = new();
    private List<AiComparisonResultDto> _results = new();

    private bool _running;
    private string _progressMessage = string.Empty;
    private int? _progressCurrent;
    private int? _progressTotal;

    private string _searchText = string.Empty;
    private string _statusFilter = "all";
    private bool _onlyProblems;

    private const string AllFilterValue = "all";
    private const string UygunFilterValue = "Uygun";
    private const string UygunDegilFilterValue = "UygunDegil";
    private const string EksikFilterValue = "Eksik";
    private const string FazlaFilterValue = "Fazla";
    private const string ManuelKontrolFilterValue = "ManuelKontrol";
    private const string EmptyActionLabel = "-";

    private class PickedFile
    {
        public string Path { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public long Size { get; set; }
        public int PageCount { get; set; }
        public bool HasError { get; set; }
    }

    private string? _initError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadCheckAsync();
            await LoadStoreCountAsync();
            DetectOpenAiConfigured();
            await LoadJobAsync();
            SetInitialStep();
        }
        catch (Exception ex)
        {
            _initError = ex.ToString();
        }
    }

    private async Task LoadCheckAsync()
    {
        _check = await CheckService.GetByIdAsync(CheckId);
        if (_check == null) return;
        _fileSizeLabel = TryGetFileSizeLabel(_check.OriginalFilePath);
    }

    private static string? TryGetFileSizeLabel(string path)
    {
        try
        {
            return File.Exists(path) ? FormatSize(new FileInfo(path).Length) : null;
        }
        catch
        {
            return null;
        }
    }

    private async Task LoadStoreCountAsync()
    {
        var list = await StoreMasterService.GetAllAsync(CompanyName, CompanyRegion);
        _storeCount = list.Count;
    }

    private void DetectOpenAiConfigured()
    {
        var key = Environment.GetEnvironmentVariable("OPENAI_API_KEY");
        _openAiConfigured = string.IsNullOrWhiteSpace(key) == false;
    }

    private void SetInitialStep()
    {
        if (_job == null) { _activeStep = 1; return; }
        var done = _job.Status == AiJobStatus.Completed || _job.Status == AiJobStatus.CompletedWithErrors || _job.Status == AiJobStatus.Failed;
        _activeStep = done ? 3 : 2;
    }

    private async Task LoadJobAsync()
    {
        _job = await Pipeline.GetLatestJobForCheckAsync(CheckId);
        if (_job == null) return;
        _pages = await Pipeline.GetPagesAsync(_job.Id);
        _manualReviewPages = _pages.Where(PageNeedsReview).ToList();
        _results = await Pipeline.GetComparisonResultsAsync(_job.Id);
    }

    private static bool PageNeedsReview(AiDocumentPageDto p) => p.RequiresManualReview;

    private void GoToStep1() => _activeStep = 0;
    private void GoToStep2() => _activeStep = 1;
    private void GoToStep3() => _activeStep = 2;
    private void GoToStep4() => _activeStep = 3;

    private string Step1SummaryLine
    {
        get
        {
            var parts = new List<string>();
            if (_check != null)
            {
                parts.Add(_check.CompanyName);
                parts.Add(_check.Region);
                parts.Add(_check.PeriodLabel);
            }
            var line = string.Join(" - ", parts);
            var rowInfo = _check != null ? _check.TotalItemCount + " satir" : string.Empty;
            var combined = line.Length > 0 ? line + " - " + rowInfo : rowInfo;
            if (_fileSizeLabel != null) combined += " - " + _fileSizeLabel;
            return combined;
        }
    }

    private bool Step2Completed => _activeStep > 1;
    private bool Step3Completed => _job != null && _running == false;
    private bool Step3HasError => _job != null && _job.Status == AiJobStatus.Failed;
    private bool Step4Completed => _job != null && (_job.Status == AiJobStatus.Completed || _job.Status == AiJobStatus.CompletedWithErrors);

    private bool CanProceedToAnalysis
    {
        get
        {
            if (_serviceFiles.Count == 0) return false;
            foreach (var f in _serviceFiles) { if (f.HasError) return false; }
            if (_noMaintenanceThisPeriod) return true;
            return _maintenanceFile != null && _maintenanceFile.HasError == false;
        }
    }

    private bool AnalyzeButtonDisabled => CanProceedToAnalysis == false || _openAiConfigured == false;
    private bool RetryButtonDisabled => _job == null || _job.FailedPages == 0;
    private string RetryButtonLabel => _job == null ? string.Empty : "Basarisiz Sayfalari Yeniden Dene (" + _job.FailedPages + ")";

    private Color OpenAiStatusColor => _openAiConfigured ? Color.Success : Color.Error;
    private string OpenAiStatusLabel => _openAiConfigured ? "Bagli" : "Yapilandirilmamis";

    private double ProgressPercent
    {
        get
        {
            if (_progressTotal is null or 0) return 0;
            var current = _progressCurrent ?? 0;
            return 100.0 * current / _progressTotal.Value;
        }
    }

    private string ProgressCounterLabel => (_progressCurrent ?? 0) + " / " + (_progressTotal ?? 0);

    private string ServiceFormsPageSummary
    {
        get
        {
            var total = 0;
            foreach (var f in _serviceFiles) total += f.PageCount;
            return total + " sayfa";
        }
    }

    private string ServiceFormsTotalLine => "Toplam: " + ServiceFormsPageSummary;

    private string MaintenanceSummary
    {
        get
        {
            if (_noMaintenanceThisPeriod) return "Yok";
            var count = _maintenanceFile != null ? _maintenanceFile.PageCount : 0;
            return count + " sayfa";
        }
    }

    private static Color FileStatusColor(PickedFile f) => f.HasError ? Color.Error : Color.Secondary;

    private static string FileStatusLabel(PickedFile f)
    {
        if (f.HasError) return "Dosya okunamadi";
        return f.PageCount + " sayfa - " + FormatSize(f.Size) + " - Analize hazir";
    }

    private void RemoveServiceFile(PickedFile f) => _serviceFiles.Remove(f);
    private void RemoveMaintenanceFile() => _maintenanceFile = null;

    private async Task AddServiceFilesAsync(IReadOnlyList<string> paths)
    {
        foreach (var path in paths)
        {
            var exists = _serviceFiles.Any(f => f.Path == path);
            if (exists) continue;
            var picked = await BuildPickedFileAsync(path);
            _serviceFiles.Add(picked);
        }
    }

    private async Task SetMaintenanceFileAsync(IReadOnlyList<string> paths)
    {
        if (paths.Count == 0) return;
        if (paths.Count > 1)
        {
            Snackbar.Add("Yalnizca ilk secilen dosya bakim formu olarak eklendi.", Severity.Info);
        }
        _maintenanceFile = await BuildPickedFileAsync(paths[0]);
    }

    private async Task<PickedFile> BuildPickedFileAsync(string path)
    {
        var file = new PickedFile();
        file.Path = path;
        file.Name = Path.GetFileName(path);
        try
        {
            file.Size = new FileInfo(path).Length;
            var ext = Path.GetExtension(path).ToLowerInvariant();
            file.PageCount = ext == ".pdf" ? await CountPdfPagesAsync(path) : 1;
        }
        catch
        {
            file.HasError = true;
            var msg = file.Name + " okunamadi. Dosya bozuk olabilir.";
            Snackbar.Add(msg, Severity.Error);
        }
        return file;
    }

    private async Task<int> CountPdfPagesAsync(string path)
    {
        var bytes = await File.ReadAllBytesAsync(path);
        return PdfRasterizer.GetPageCount(bytes);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("0.#") + " KB";
        return (bytes / 1024.0 / 1024.0).ToString("0.#") + " MB";
    }

    private async Task OpenStoreImportDialog()
    {
        var parameters = new DialogParameters();
        parameters.Add("CompanyName", CompanyName);
        parameters.Add("Region", CompanyRegion);
        var dialog = await DialogService.ShowAsync<HakedisOtomasyon.Web.Components.SogutmaKontrol.StoreImportDialog>("Magaza Listesi Ice Aktar", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;
        await LoadStoreCountAsync();
        Snackbar.Add("Magaza listesi guncellendi.", Severity.Success);
    }

    private async Task RunAnalysisAsync()
    {
        _running = true;
        _progressMessage = "Baslatiliyor...";
        _progressCurrent = null;
        _progressTotal = null;
        StateHasChanged();

        try
        {
            var serviceForms = await BuildServiceFormPayloadAsync();
            var maintenanceBytes = await BuildMaintenancePayloadAsync();
            var progress = BuildProgressReporter();
            var maintenanceName = _maintenanceFile != null ? _maintenanceFile.Name : null;

            _job = await Pipeline.RunAsync(CheckId, serviceForms, maintenanceBytes, maintenanceName, progress);

            await LoadJobAsync();
            _activeStep = 3;
            Snackbar.Add("Yapay zeka kontrolu tamamlandi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Analiz hatasi: " + ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task<List<(byte[], string)>> BuildServiceFormPayloadAsync()
    {
        var list = new List<(byte[], string)>();
        foreach (var f in _serviceFiles)
        {
            var bytes = await File.ReadAllBytesAsync(f.Path);
            list.Add((bytes, f.Name));
        }
        return list;
    }

    private async Task<byte[]?> BuildMaintenancePayloadAsync()
    {
        if (_maintenanceFile == null) return null;
        return await File.ReadAllBytesAsync(_maintenanceFile.Path);
    }

    private Progress<AiJobProgressUpdate> BuildProgressReporter()
    {
        return new Progress<AiJobProgressUpdate>(OnProgressUpdate);
    }

    private void OnProgressUpdate(AiJobProgressUpdate u)
    {
        _progressMessage = u.Message;
        _progressCurrent = u.Current;
        _progressTotal = u.Total;
        InvokeAsync(StateHasChanged);
    }

    private async Task RetryFailedAsync()
    {
        if (_job == null) return;
        _running = true;
        StateHasChanged();
        try
        {
            var progress = new Progress<AiJobProgressUpdate>(OnRetryProgressUpdate);
            _job = await Pipeline.RetryFailedPagesAsync(_job.Id, progress);
            await LoadJobAsync();
            Snackbar.Add("Yeniden deneme tamamlandi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Yeniden deneme hatasi: " + ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private void OnRetryProgressUpdate(AiJobProgressUpdate u)
    {
        _progressMessage = u.Message;
        InvokeAsync(StateHasChanged);
    }

    private async Task CorrectStoreAsync(AiDocumentPageDto page)
    {
        var parameters = new DialogParameters();
        parameters.Add("CompanyName", CompanyName);
        parameters.Add("Region", CompanyRegion);
        parameters.Add("PageCodeRaw", page.StoreCodeRaw);
        parameters.Add("PageNameRaw", page.StoreNameRaw);
        var dialog = await DialogService.ShowAsync<AiStoreCorrectionDialog>("Magazayi Kesinlestir", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;
        var selected = result.Data as StoreDto;
        if (selected == null) return;
        await Pipeline.CorrectPageStoreAsync(page.Id, selected.Id);
        await LoadJobAsync();
        Snackbar.Add("Magaza guncellendi.", Severity.Success);
    }

    private async Task CorrectMaterialAsync(AiPageMaterialDto material)
    {
        var parameters = new DialogParameters();
        parameters.Add("Material", material);
        var dialog = await DialogService.ShowAsync<AiMaterialCorrectionDialog>("Malzeme Miktarini Duzelt", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;
        if (result.Data is not ValueTuple<decimal?, string?, string?> correction) return;
        await Pipeline.CorrectMaterialAsync(material.Id, correction.Item1, correction.Item2, correction.Item3);
        await LoadJobAsync();
        Snackbar.Add("Malzeme guncellendi.", Severity.Success);
    }

    private void OnStatusFilterChanged(string? value)
    {
        _statusFilter = value ?? AllFilterValue;
    }

    private Func<AiComparisonResultDto, bool> TableFilter => FilterResult;

    private bool FilterResult(AiComparisonResultDto r)
    {
        if (_onlyProblems && r.Status == UygunFilterValue) return false;
        if (_statusFilter != AllFilterValue && r.Status != _statusFilter) return false;
        if (string.IsNullOrEmpty(_searchText)) return true;
        var q = _searchText.Trim();
        var inStore = r.StoreLabel.Contains(q, StringComparison.OrdinalIgnoreCase);
        var inDesc = r.Description.Contains(q, StringComparison.OrdinalIgnoreCase);
        return inStore || inDesc;
    }

