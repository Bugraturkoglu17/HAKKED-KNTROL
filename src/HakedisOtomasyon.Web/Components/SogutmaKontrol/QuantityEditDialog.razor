@namespace SogutmaHakedisKontrol.Web.Components

<MudDialog Style="min-width:380px">
    <TitleContent><MudText Typo="Typo.h6">Miktarı Düzelt</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@MaterialName</MudText>
        <MudNumericField T="decimal" @bind-Value="_value" Label="Miktar" Variant="Variant.Outlined" Format="0.####" Autofocus />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            Bu değişiklik denetim notuna işlenecektir.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => MudDialog.Close(DialogResult.Ok(_value)))">
            Kaydet
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string MaterialName { get; set; } = string.Empty;
    [Parameter] public decimal CurrentQuantity { get; set; }

    private decimal _value;

    protected override void OnInitialized() => _value = CurrentQuantity;
}
