@using SogutmaHakedisKontrol.Application.DTOs

<MudDialog Style="min-width:420px">
    <TitleContent><MudText Typo="Typo.h6">Mağazayı Düzelt</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Hakedişteki mağaza: @(Result.HakedisValue ?? "—")
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_storeRaw" Label="Formda Okuduğunuz Mağaza Kodu/Adı" Variant="Variant.Outlined" Autofocus />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_note" Label="Not (opsiyonel)" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            Girdiğiniz mağaza kodu/adı hakedişteki mağazayla otomatik karşılaştırılır — eşleşirse "Uygun",
            farklıysa "Uygun Değil" olarak işaretlenir. Bu bir onay değil, gerçek bir okumadır.
        </MudText>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Dense Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Kaydet</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AiComparisonResultDto Result { get; set; } = null!;

    private string? _storeRaw;
    private string? _note;
    private string? _error;

    // Not: Kaydet düğmesi kasıtlı olarak asla "Disabled" değil — bkz. AiQuantityCorrectionDialog'daki
    // aynı gerekçe.
    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_storeRaw))
        {
            _error = "Lütfen formda okuduğunuz mağaza kodu/adını girin.";
            return;
        }
        _error = null;
        MudDialog.Close(DialogResult.Ok((_storeRaw.Trim(), _note)));
    }
}
