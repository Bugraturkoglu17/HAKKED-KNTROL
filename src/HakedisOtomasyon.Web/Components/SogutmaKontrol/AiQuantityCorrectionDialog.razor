@using SogutmaHakedisKontrol.Application.DTOs

<MudDialog Style="min-width:420px">
    <TitleContent><MudText Typo="Typo.h6">@Result.Description Düzelt</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight:600">@Result.StoreLabel</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Hakedişte talep edilen: @(Result.HakedisValue ?? "—")
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="8">
                <MudNumericField T="decimal?" @bind-Value="_quantity" Immediate="true" Label="Formda Okuduğunuz Miktar" Variant="Variant.Outlined" Autofocus />
            </MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="_unit" Label="Birim" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_note" Label="Not (opsiyonel)" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            Girdiğiniz miktar hakedişteki değerle otomatik karşılaştırılır — eşleşirse "Uygun",
            farklıysa "Uygun Değil" olarak işaretlenir. Bu bir onay değil, gerçek bir ölçümdür.
        </MudText>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Dense Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Kaydet</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AiComparisonResultDto Result { get; set; } = null!;

    private decimal? _quantity;
    private string? _unit = "kg";
    private string? _note;
    private string? _error;

    // Not: Kaydet düğmesi kasıtlı olarak asla "Disabled" değil — MudNumericField'ın bağlı değeri
    // (Immediate="true" olsa bile) her ortamda anlık güncellenmeyebiliyor; düğme devre dışı kalırsa
    // kullanıcıya hiç geri bildirim vermeden "tıklayınca hiçbir şey olmuyor" izlenimi yaratıyordu.
    // Bunun yerine burada açıkça doğrulanıp eksikse net bir hata mesajı gösteriliyor.
    private void Submit()
    {
        if (_quantity is null)
        {
            _error = "Lütfen formda okuduğunuz miktarı girin.";
            return;
        }
        _error = null;
        MudDialog.Close(DialogResult.Ok((_quantity, _unit, _note)));
    }
}
