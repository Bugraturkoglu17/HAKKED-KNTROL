@namespace SogutmaHakedisKontrol.Web.Components

<MudDialog Style="min-width:560px">
    <TitleContent>
        <MudText Typo="Typo.h6">@(Item.Id == 0 ? "Yeni Birim Fiyat Kalemi" : "Birim Fiyat Kalemi Düzenle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Item.Category" Label="Kategori" Variant="Variant.Outlined" MaxLength="200" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Item.ItemCode" Label="Malzeme Kodu (referans)" Variant="Variant.Outlined" MaxLength="50" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Item.MaterialName" Label="Malzeme Adı *" Variant="Variant.Outlined" Required MaxLength="500" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Item.Brand" Label="Marka" Variant="Variant.Outlined" MaxLength="300" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Item.Spec" Label="Tip / Ölçü" Variant="Variant.Outlined" MaxLength="300"
                              HelperText="Teknik ölçü — eşleştirmede kritik (ör. 3/8, 10 mm)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Item.Unit" Label="Birim" Variant="Variant.Outlined" MaxLength="50" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" @bind-Value="Item.Price" Label="Fiyat *" Variant="Variant.Outlined" Min="0" Format="N4" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="Item.Currency" Label="Para Birimi" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem T="string" Value="@("TRY")">TL</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="Item.IsActive" Color="Color.Success" Label="Aktif" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(Item.MaterialName))">
            Kaydet
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public UnitPriceItemDto Item { get; set; } = new();

    private void Submit()
    {
        Item.MaterialName = Item.MaterialName.Trim();
        MudDialog.Close(DialogResult.Ok(Item));
    }

    private void Cancel() => MudDialog.Cancel();
}
