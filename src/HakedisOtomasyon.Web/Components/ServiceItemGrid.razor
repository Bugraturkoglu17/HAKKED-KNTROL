@namespace HakedisOtomasyon.Web.Components
@using System.Globalization
@using HakedisOtomasyon.Infrastructure.Services
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDisciplineCalculationRuleFactory CalculationRuleFactory
@inject CurrentDisciplineService CurrentDiscipline

<MudStack Spacing="3">
    <!-- ─── Üst araç çubuğu: arama + boş satır ekle ─────────────────── -->
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" md="9">
            <MudAutocomplete T="PriceItemDto"
                             Label="Fiyat listesinden kalem seç..."
                             Placeholder="Örn: sprinkler 68°C K80, flex 160, menfez 800x300"
                             Value="@_selectedPriceItem"
                             ValueChanged="@AddFromPriceList"
                             SearchFunc="@SearchPriceItems"
                             ToStringFunc="@(p => p?.GetDisplayName() ?? "")"
                             Variant="Variant.Outlined"
                             Dense
                             Clearable
                             MinCharacters="2"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Adornment="Adornment.Start"
                             DebounceInterval="250">
                <ItemTemplate Context="item">
                    <div class="pa-1">
                        <MudText Typo="Typo.body2" Style="line-height:1.3">@item.GetDisplayName()</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @if (item.PriceType == PriceType.VariablePrice)
                            {
                                <span>Değişken Fiyat | Birim: @item.Unit</span>
                            }
                            else
                            {
                                <span>Malzeme: @item.MaterialPrice.ToString("N2", TrCulture)&nbsp;₺ | İşçilik: @item.LaborPrice.ToString("N2", TrCulture)&nbsp;₺ | Birim: @item.Unit | Toplam: @item.UnitPrice.ToString("N2", TrCulture)&nbsp;₺</span>
                            }
                        </MudText>
                    </div>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="px-4 py-2" Color="Color.Warning">
                        Sonuç bulunamadı. Fiyat listesi boş olabilir veya aradığınız kalem listede yok.
                    </MudText>
                </NoItemsTemplate>
            </MudAutocomplete>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.AddBox"
                       OnClick="@(() => OpenManualItemDialog(null))"
                       Size="Size.Medium"
                       Style="white-space:nowrap">
                Manuel Kalem Ekle
            </MudButton>
        </MudItem>
    </MudGrid>

    <!-- ─── Kalem Tablosu ─────────────────────────────────────────────── -->
    <div class="service-table-container">
        <MudTable Items="@Items" Dense Hover Elevation="0"
                  Class="service-items-table"
                  Style="table-layout:fixed; min-width:860px">
            <HeaderContent>
                <MudTh Style="width:36px; text-align:center">No</MudTh>
                <MudTh Style="width:190px">Açıklama</MudTh>
                <MudTh Style="width:66px; text-align:center">Miktar</MudTh>
                <MudTh Style="width:46px; text-align:center">Birim</MudTh>
                <MudTh Style="width:98px; text-align:center">Malzeme (₺)</MudTh>
                <MudTh Style="width:98px; text-align:center">İşçilik (₺)</MudTh>
                <MudTh Style="width:116px; text-align:center">Birim Fiyat</MudTh>
                <MudTh Style="width:124px; text-align:center">Toplam Fiyat</MudTh>
                <MudTh Style="width:58px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- No -->
                <MudTd Class="sit-td-no">@(Items.IndexOf(context) + 1)</MudTd>

                <!-- Açıklama -->
                <MudTd Class="sit-td-desc">
                    <MudTooltip Text="@context.Description"
                                Arrow="true"
                                Placement="Placement.Bottom"
                                Disabled="@(string.IsNullOrWhiteSpace(context.Description))"
                                Class="desc-tooltip"
                                RootStyle="width:100%; display:block">
                        <span class="sit-desc-text">
                            @if (context.IsAutoGenerated)
                            {
                                <span style="background:#1976d2;color:white;padding:1px 4px;border-radius:3px;font-size:9px;margin-right:3px;vertical-align:middle">OTO</span>
                            }
                            @context.Description
                        </span>
                    </MudTooltip>
                </MudTd>

                <!-- Miktar -->
                <MudTd Class="sit-td-num">
                    @if (context.IsAutoGenerated && context.AutoGeneratedType != "BlackSteelPipeRedOxidePaint" && context.AutoGeneratedType != "BlackSteelPipePolisanPaint")
                    {
                        <span class="sit-unit-text" style="display:block;text-align:center">%@((int)context.Quantity)</span>
                    }
                    else if (context.IsAutoGenerated)
                    {
                        <span class="sit-unit-text" style="display:block;text-align:right">@context.Quantity.ToString("N2", TrCulture)</span>
                    }
                    else
                    {
                        <MudNumericField T="decimal" Value="context.Quantity"
                                         Variant="Variant.Text" Dense Margin="Margin.Dense"
                                         Min="0.01m" Format="N2"
                                         HideSpinButtons="false"
                                         Class="num-right"
                                         ValueChanged="@(v => OnQuantityChanged(context, v))" />
                    }
                </MudTd>

                <!-- Birim -->
                <MudTd Class="sit-td-unit">
                    <span class="sit-unit-text">@context.Unit</span>
                </MudTd>

                <!-- Malzeme -->
                <MudTd Class="sit-td-num">
                    <span class="price-amount">@context.MaterialPrice.ToString("N2", TrCulture)&nbsp;₺</span>
                </MudTd>

                <!-- İşçilik -->
                <MudTd Class="sit-td-num">
                    <span class="price-amount">@context.LaborPrice.ToString("N2", TrCulture)&nbsp;₺</span>
                </MudTd>

                <!-- Birim Fiyat (hesaplanan, sadece gösterim) -->
                <MudTd Class="sit-td-price">
                    <span class="price-amount">@context.UnitPrice.ToString("N2", TrCulture)&nbsp;₺</span>
                </MudTd>

                <!-- Toplam Fiyat (hesaplanan, sadece gösterim) -->
                <MudTd Class="sit-td-totalprice">
                    <span class="price-amount price-total">@context.TotalPrice.ToString("N2", TrCulture)&nbsp;₺</span>
                </MudTd>

                <!-- İşlemler -->
                <MudTd Class="sit-td-actions">
                    @if (!context.IsAutoGenerated)
                    {
                        @if (context.IsManualEntry)
                        {
                            <MudTooltip Text="Kalemi Düzenle">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small" Color="Color.Warning"
                                               OnClick="@(() => OpenManualItemDialog(context))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Satırı Çoğalt">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small" Color="Color.Info"
                                           OnClick="@(() => DuplicateRow(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Satırı Sil">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteRow(context))" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudAlert Severity="Severity.Info" Dense Class="ma-2">Henüz kalem eklenmedi.</MudAlert>
            </NoRecordsContent>
        </MudTable>
    </div>
</MudStack>

@code {
    [Parameter] public List<ServiceItemDto> Items { get; set; } = new();
    [Parameter] public IPriceListService PriceListService { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public ProgressClaimDto? Claim { get; set; }

    private static readonly CultureInfo TrCulture = new("tr-TR");
    private PriceItemDto? _selectedPriceItem;
    private bool _initialGroupRuleApplied = false;

    /// <summary>Aktif disipline ait hesaplama kuralları (Yangın ise fittings/boya/BDKF/BDTX/Flexiva çalışır).</summary>
    private IDisciplineCalculationRules GetRules() => CalculationRuleFactory.GetRules(CurrentDiscipline.CurrentDiscipline);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialGroupRuleApplied && Items.Any(x => !x.IsAutoGenerated))
        {
            _initialGroupRuleApplied = true;
            await GetRules().ApplyAutomaticItemsAsync(Items, Claim);
            StateHasChanged();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task<IEnumerable<PriceItemDto>> SearchPriceItems(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value)) return [];
        try
        {
            var results = await PriceListService.SearchAsync(value);
            return results;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Arama hatası: {ex.Message}", Severity.Error);
            return [];
        }
    }

    private async Task AddFromPriceList(PriceItemDto? item)
    {
        // Reset the autocomplete control immediately regardless of selection
        _selectedPriceItem = null;

        if (item is null) return;

        var rules = GetRules();

        // ── Döviz bazlı ürün (BDTX / BDKF): dialog ile hesapla ───────────────
        if (rules.IsCurrencyBasedItem(item))
        {
            var dto = await OpenCurrencyItemDialog(item);
            if (dto is null) return; // kullanıcı iptal etti
            dto.SortOrder = Items.Count + 1;
            Items.Add(dto);
            for (int i = 0; i < Items.Count; i++) Items[i].SortOrder = i + 1;
            await OnChanged.InvokeAsync();
            StateHasChanged();
            return;
        }

        var stdDto = new ServiceItemDto
        {
            LocalId = Guid.NewGuid(),
            Description = item.GetInvoiceDescription(),
            Unit = string.IsNullOrWhiteSpace(item.Unit) ? "Ad" : item.Unit,
            MaterialPrice = item.MaterialPrice,
            LaborPrice = item.LaborPrice,
            Quantity = 1,
            SortOrder = Items.Count + 1
        };

        // Hangi otomatik kuralın tetikleneceğini aktif disiplinin kurallarına sor
        rules.ApplyTriggerForNewItem(stdDto, item);

        stdDto.Recalculate();
        Items.Add(stdDto);
        await rules.ApplyAutomaticItemsAsync(Items, Claim);

        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnQuantityChanged(ServiceItemDto item, decimal quantity)
    {
        if (quantity <= 0) quantity = 0.01m;
        item.Quantity = quantity;
        item.Recalculate();
        if (!item.IsAutoGenerated)
            await GetRules().ApplyAutomaticItemsAsync(Items, Claim);
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task OpenManualItemDialog(ServiceItemDto? existing)
    {
        var parameters = new DialogParameters<ManualItemDialog>();
        if (existing is not null)
            parameters.Add(x => x.Item, existing);

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var title = existing is null ? "Manuel Kalem Ekle" : "Manuel Kalem Düzenle";
        var dialog = await DialogService.ShowAsync<ManualItemDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is ServiceItemDto saved)
        {
            if (existing is null)
            {
                saved.SortOrder = Items.Count + 1;
                Items.Add(saved);
            }
            else
            {
                existing.Description = saved.Description;
                existing.Unit = saved.Unit;
                existing.MaterialPrice = saved.MaterialPrice;
                existing.LaborPrice = saved.LaborPrice;
                existing.Quantity = saved.Quantity;
                existing.Recalculate();
            }
            await GetRules().ApplyAutomaticItemsAsync(Items, Claim);
            await OnChanged.InvokeAsync();
            StateHasChanged();
        }
    }

    private async Task AddEmptyRow()
    {
        Items.Add(new ServiceItemDto
        {
            Description = "",
            Unit = "Ad",
            Quantity = 1,
            MaterialPrice = 0,
            LaborPrice = 0,
            UnitPrice = 0,
            TotalPrice = 0,
            IsInvoiceBased = false,
            SortOrder = Items.Count + 1
        });
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task DuplicateRow(ServiceItemDto item)
    {
        if (item.IsAutoGenerated) return; // auto-generated rows cannot be duplicated independently

        var copy = new ServiceItemDto
        {
            LocalId = Guid.NewGuid(),
            Description = item.Description, Unit = item.Unit,
            MaterialPrice = item.MaterialPrice, LaborPrice = item.LaborPrice,
            Quantity = item.Quantity, UnitPrice = item.UnitPrice, TotalPrice = item.TotalPrice,
            IsInvoiceBased = item.IsInvoiceBased, IsManualEntry = item.IsManualEntry,
            AutoRuleTrigger = item.AutoRuleTrigger,
            ExportDescription = item.ExportDescription,
            SortOrder = Items.Count + 1
        };
        var idx = Items.IndexOf(item);
        Items.Insert(idx + 1, copy);
        await GetRules().ApplyAutomaticItemsAsync(Items, Claim);
        for (int i = 0; i < Items.Count; i++) Items[i].SortOrder = i + 1;
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task DeleteRow(ServiceItemDto item)
    {
        if (!item.IsAutoGenerated)
            Items.RemoveAll(x => x.IsAutoGenerated && x.ParentLocalId == item.LocalId);
        Items.Remove(item);
        await GetRules().ApplyAutomaticItemsAsync(Items, Claim);
        for (int i = 0; i < Items.Count; i++) Items[i].SortOrder = i + 1;
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    // ─── Aşama 4: fittings/boya/izolasyon/BDKF/BDTX/Flexiva mantığı artık
    // IDisciplineCalculationRuleFactory üzerinden FireCalculationRules'a taşındı.
    // Bu component artık sadece UI etkileşimini (dialog açma, satır ekleme/silme)
    // yönetiyor; otomatik hesaplama GetRules().ApplyAutomaticItemsAsync(...) ile çalışıyor.

    private async Task<ServiceItemDto?> OpenCurrencyItemDialog(PriceItemDto item)
    {
        var parameters = new DialogParameters<CurrencyItemDialog>();
        parameters.Add(x => x.PriceItem, item);
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog  = await DialogService.ShowAsync<CurrencyItemDialog>("Döviz Bazlı Ürün Hesapla", parameters, options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return null;
        return result.Data as ServiceItemDto;
    }

}
