@namespace HakedisOtomasyon.Web.Components
@using HakedisOtomasyon.Application
@using HakedisOtomasyon.Application.DTOs
@inject IFormNumberReader Reader
@inject IHandwrittenStoreReader StoreReader
@inject IFileStorageService FileStorage
@inject ISnackbar Snackbar

@* Açık servis formundan:
     • sağ üstteki form numarasını Windows OCR ile (yapay zekâ yok) okuyup Bakım Form No'ya yazar,
     • elle yazılmış mağaza kodunu/adını yapay zekâ (Gemini) ile okuyup mağaza listesiyle eşler,
     • aynı istekte formun altındaki TARİH'in gün/ayını okur; yıl okunmaz, içinde bulunulan yıl alınır. Ay hakediş ayından
       farklıysa uyarı verilir (yanlış okuma ya da başka aya ait form olabilir).
   Mağaza kodla bulunduysa seçilir; yalnız adla bulunduysa seçilir ama "kontrol edin" uyarısı verilir; emin olunamazsa
   en yakın mağazalar öneri olarak gösterilir. Çok sayfalı PDF'de yalnız AÇIK sayfa okunur (her sayfa ayrı servis formu). *@

<MudStack Row AlignItems="AlignItems.Center" Spacing="1" Style="flex-wrap:wrap;justify-content:flex-end">
    @if (_suggestions.Count > 0)
    {
        @* Öneriler tek küçük açılır menüde — çip listesi kartın üstünü kaplıyordu *@
        <MudMenu Dense AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ArrowDropDown" Style="font-size:12px;padding:2px 6px;text-transform:none">
                    Mağaza önerisi (@_suggestions.Count)
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @foreach (var s in _suggestions)
                {
                    <MudMenuItem OnClick="@(() => PickSuggestionAsync(s))">@s.Code — @s.Name</MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem OnClick="@(() => _suggestions = new())">Önerileri kapat</MudMenuItem>
            </ChildContent>
        </MudMenu>
    }
    <MudTooltip Text="@TooltipText">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.AutoFixHigh"
                   Disabled="@(_busy || _pageCount < 1 || PageIndex >= _pageCount)" OnClick="ReadAsync">
            @(_busy ? "Okunuyor..." : "Otomatik doldur")
        </MudButton>
    </MudTooltip>
</MudStack>

@code {
    /// <summary>Açık servis formunun saklanan (göreli) dosya yolu.</summary>
    [Parameter] public string? FilePath { get; set; }

    /// <summary>Okunacak sayfa (0 tabanlı) — çok sayfalı PDF'de sol panelde açık olan sayfa.</summary>
    [Parameter] public int PageIndex { get; set; }

    /// <summary>Okunan form numarası.</summary>
    [Parameter] public EventCallback<string> OnRead { get; set; }

    /// <summary>Mağaza listesi (verilmezse mağaza okunmaz).</summary>
    [Parameter] public IReadOnlyList<StoreDto>? Stores { get; set; }

    /// <summary>Hakedişin bölgesi (hakedişteki formların mağazalarından); adla eşleşme önce bu bölgede aranır.</summary>
    [Parameter] public string? PreferredRegion { get; set; }

    /// <summary>Ekranda seçili mağaza — değişince (öneri seçildi, elle seçildi, Temizle) öneriler kapanır.</summary>
    [Parameter] public StoreDto? CurrentStore { get; set; }

    /// <summary>Seçilen mağaza.</summary>
    [Parameter] public EventCallback<StoreDto> OnStore { get; set; }

    /// <summary>Okunan servis tarihi (gün/ay formdan, yıl içinde bulunulan yıl).</summary>
    [Parameter] public EventCallback<DateTime> OnDate { get; set; }

    /// <summary>Hakedişin ayı (1–12) — okunan ay farklıysa uyarı verilir.</summary>
    [Parameter] public int? ClaimMonth { get; set; }

    private string? _countedPath;
    private string? _suggestFor;      // önerilerin ait olduğu dosya + sayfa
    private int _pageCount = -1;     // -1: henüz bilinmiyor
    private bool _busy;
    private List<StoreDto> _suggestions = new();
    private int? _storeIdAtSuggest;

    private bool ReadsStore => Stores is { Count: > 0 } && StoreReader.IsConfigured;

    private string PageKey => $"{FilePath}#{PageIndex}";

    private string TooltipText => _pageCount switch
    {
        > 0 => (_pageCount > 1 ? $"Sayfa {PageIndex + 1} / {_pageCount}: " : string.Empty)
            + (ReadsStore ? "form numarasını (sağ üst), elle yazılmış mağazayı ve tarihi okuyup doldurur"
                          : "formun sağ üstündeki numarayı okuyup Form No alanına yazar"),
        0 => "Dosya okunamadı",
        _ => "Dosya kontrol ediliyor...",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_suggestions.Count > 0 && (CurrentStore?.Id != _storeIdAtSuggest || _suggestFor != PageKey)) _suggestions = new();

        if (string.Equals(_countedPath, FilePath, StringComparison.Ordinal)) return;
        _countedPath = FilePath;
        _suggestions = new();
        _pageCount = -1;
        if (string.IsNullOrWhiteSpace(FilePath)) { _pageCount = 0; return; }
        var path = FilePath;
        var count = await Reader.GetPageCountAsync(FileStorage.GetAbsolutePath(path));
        if (string.Equals(_countedPath, path, StringComparison.Ordinal)) _pageCount = count;   // bu arada dosya değiştiyse eski sonucu yazma
    }

    // Bir okumanın sonuçları tek, küçük bir bildirimde alan etiketleri olarak gösterilir:
    // kontrol edilecek alan sarı (hakediş ayı uyuşmazlığında kırmızı), doğru okunan alan yeşil + ✓.
    // Ayrıntı (Text) bilinçli olarak gösterilmez. Görünüm: app.css → .af-chips
    private readonly List<(Severity Level, string Label, string Text)> _notes = new();

    private void Note(Severity level, string label, string text) => _notes.Add((level, label, text));

    private void FlushNotes()
    {
        if (_notes.Count == 0) return;
        var fields = _notes.GroupBy(n => n.Label).Select(g => (Label: g.Key, Level: g.Max(n => n.Level))).ToList();
        var needsCheck = fields.Any(f => f.Level >= Severity.Warning);
        var chips = string.Join("", fields
            .OrderByDescending(f => f.Level >= Severity.Warning)
            .Select(f =>
            {
                var label = System.Net.WebUtility.HtmlEncode(f.Label);
                return f.Level switch
                {
                    Severity.Error => $"<span class=\"af-chip af-err\">{label}</span>",
                    Severity.Warning => $"<span class=\"af-chip af-warn\">{label}</span>",
                    _ => $"<span class=\"af-chip af-ok\">{label} ✓</span>",
                };
            }));
        var icon = needsCheck ? "<span class=\"af-icon\" title=\"Kontrol edin\">&#9888;</span>" : string.Empty;
        Snackbar.Add(new MarkupString($"<div class=\"af-chips\">{icon}{chips}</div>"), Severity.Normal, o =>
        {
            o.VisibleStateDuration = needsCheck ? 6000 : 2500;
            o.HideIcon = true;
            o.ShowCloseIcon = false;
        });
        _notes.Clear();
    }

    private async Task ReadAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(FilePath)) return;
        _busy = true;
        _suggestions = new();
        _notes.Clear();
        var path = FilePath;
        var page = PageIndex;
        var key = PageKey;
        try
        {
            var absolute = FileStorage.GetAbsolutePath(path);
            var numberTask = Reader.ReadAsync(absolute, page);
            var storeTask = ReadsStore ? ReadStoreAsync(absolute, page) : Task.FromResult<HandwrittenStoreResult?>(null);   // OCR ile aynı anda

            var result = await numberTask;
            if (PageKey != key) return;   // okurken başka dosyaya/sayfaya geçildi
            if (result.Number is not null)
            {
                await OnRead.InvokeAsync(result.Number);
                Note(Severity.Success, "Form No", result.Number);
            }
            else
            {
                Note(Severity.Warning, "Form No", "okunamadı, kontrol edin");
            }

            var store = await storeTask;
            if (store is null || PageKey != key) return;
            await ApplyDateAsync(store);
            await ApplyStoreAsync(store);
        }
        catch (Exception ex)
        {
            HakedisOtomasyon.Web.WpfApp.LogError("Otomatik doldur", ex);   // ayrıntı log dosyasına; kullanıcıya yalnız kontrol uyarısı
            Note(Severity.Warning, "Tüm alanlar", "okuma tamamlanamadı");
        }
        finally
        {
            _busy = false;
            if (PageKey == key) FlushNotes(); else _notes.Clear();
        }
    }

    private async Task<HandwrittenStoreResult?> ReadStoreAsync(string absolutePath, int page) => await StoreReader.ReadAsync(absolutePath, page);

    private static readonly System.Globalization.CultureInfo Tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    /// <summary>Gün/ay formdan, yıl içinde bulunulan yıl (kullanıcı kuralı: yıl formdan okunmaz).</summary>
    private async Task ApplyDateAsync(HandwrittenStoreResult read)
    {
        if (read.Error is not null) return;   // mağaza mesajında zaten bildirilir
        var date = HandwrittenDate.Compose(read.Day, read.Month, DateTime.Today.Year);
        if (date is null)
        {
            Note(Severity.Warning, "Tarih", "okunamadı, elle girin");
            return;
        }
        await OnDate.InvokeAsync(date.Value);
        if (ClaimMonth is int month and >= 1 and <= 12 && date.Value.Month != month)
            Note(Severity.Error, "Tarih", $"{date.Value:dd.MM.yyyy} — hakediş ayı {Tr.DateTimeFormat.GetMonthName(month).ToUpper(Tr)}, kontrol edin!");
        else
            Note(Severity.Info, "Tarih", $"{date.Value:dd.MM.yyyy}");
    }

    private async Task ApplyStoreAsync(HandwrittenStoreResult read)
    {
        var keep = CurrentStore is null ? string.Empty : $" ({CurrentStore.Code} korundu)";
        if (read.Error is not null)
        {
            Note(Severity.Warning, "Mağaza", $"okunamadı, kontrol edin{keep}");
            return;
        }
        if (read.StoreCode is null && read.StoreName is null)
        {
            Note(Severity.Warning, "Mağaza", $"formda bulunamadı, elle seçin{keep}");
            return;
        }

        var written = string.Join(" ", new[] { read.StoreName, read.StoreCode is null ? null : $"({read.StoreCode})" }.Where(x => x is not null));
        var match = StoreMatcher.Match(read.StoreCode, read.StoreName, Stores!, PreferredRegion);
        if (match.Selected is not null)
        {
            await OnStore.InvokeAsync(match.Selected);
            if (match.Method == "kod")
                Note(Severity.Success, "Mağaza", $"{match.Selected.Code} — {match.Selected.Name}");
            else
                Note(Severity.Warning, "Mağaza", $"{match.Selected.Code} — {match.Selected.Name} (adla eşlendi, formda \"{written}\"; kontrol edin)");
            return;
        }
        if (match.Suggestions.Count > 0)
        {
            _suggestions = match.Suggestions.ToList();
            _storeIdAtSuggest = CurrentStore?.Id;
            _suggestFor = PageKey;
            Note(Severity.Warning, "Mağaza", $"\"{written}\" kesin bulunamadı, önerilerden seçin{keep}");
            return;
        }
        Note(Severity.Warning, "Mağaza", $"\"{written}\" listede yok{keep}");
    }

    private async Task PickSuggestionAsync(StoreDto store)
    {
        _suggestions = new();
        await OnStore.InvokeAsync(store);
    }
}
