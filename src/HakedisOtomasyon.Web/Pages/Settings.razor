    private async Task SaveArchiveRetentionAsync()
    {
        await SettingsService.SetAsync(SettingKeys.ArchiveRetentionDays, _archiveRetentionValue);
        Snackbar.Add("Arşiv saklama süresi kaydedildi.", Severity.Success);
    }

    private async Task CleanArchiveAsync()
    {
        var retentionStr = _archiveRetentionValue;
        if (!int.TryParse(retentionStr, out var days) || days <= 0)
        {
            Snackbar.Add("Süresiz seçiliyken temizleme yapılmaz.", Severity.Info);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Arşivi Temizle",
            $"{days} günden eski arşiv dosyaları kalıcı olarak silinecek. Devam edilsin mi?",
            "Evet, Temizle", cancelText: "İptal");
        if (confirm != true) return;

        _archiveBusy = true;
        _archiveStatus = "Arşiv temizleniyor...";
        StateHasChanged();
        try
        {
            var deleted = await CleanupService.CleanupArchiveOlderThanAsync(days);
            Snackbar.Add($"Arşiv temizlendi: {deleted} dosya silindi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Temizleme hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _archiveBusy = false;
            _archiveStatus = string.Empty;
            StateHasChanged();
        }
    }

