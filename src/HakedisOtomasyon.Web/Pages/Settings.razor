    // ─── Veri Klasörü ─────────────────────────────────────────────────────

    private Task RefreshFolderSizesAsync()
    {
        try
        {
            long total = GetDirSize(AppPath.DataRootPath);

            long serviceFormsTotal = 0, invoicesTotal = 0, excelTotal = 0;
            if (System.IO.Directory.Exists(AppPath.HakedislerPath))
            {
                foreach (var yearDir in System.IO.Directory.EnumerateDirectories(AppPath.HakedislerPath))
                    foreach (var monthDir in System.IO.Directory.EnumerateDirectories(yearDir))
                    {
                        serviceFormsTotal += GetDirSize(System.IO.Path.Combine(monthDir, "Servis Formları"));
                        invoicesTotal += GetDirSize(System.IO.Path.Combine(monthDir, "Faturalar"));
                        excelTotal += GetDirSize(System.IO.Path.Combine(monthDir, "Excel Çıktıları"));
                    }
            }

            _folderSizes = new Dictionary<string, string>
            {
                ["Toplam"] = FormatBytes(total),
                ["Servis Formları"] = FormatBytes(serviceFormsTotal),
                ["Faturalar"] = FormatBytes(invoicesTotal),
                ["Excel Çıktıları"] = FormatBytes(excelTotal),
            };
        }
        catch
        {
            _folderSizes = null;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static long GetDirSize(string path)
    {
        if (!System.IO.Directory.Exists(path)) return 0;
        return new System.IO.DirectoryInfo(path)
            .EnumerateFiles("*", System.IO.SearchOption.AllDirectories)
            .Sum(f => f.Length);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / 1024.0 / 1024.0:F1} MB";
        return $"{bytes / 1024.0 / 1024.0 / 1024.0:F2} GB";
    }

    private async Task ChangeDataFolderAsync()
    {
        var selected = await FilePicker.PickFolderAsync("Yeni HAKEDİŞ DATABASE klasörünü seçin");
        if (string.IsNullOrWhiteSpace(selected)) return;

        // Taşıma mı yoksa sadece bağlama mı?
        var moveResult = await DialogService.ShowMessageBox(
            "Veri Klasörü Değiştir",
            $"Seçilen klasör:\n{selected}\n\nMevcut veriler yeni klasöre taşınsın mı?",
            yesText: "Evet, Verileri Taşı",
            noText: "Hayır, Sadece Bağla",
            cancelText: "İptal");

        if (moveResult is null) return; // İptal

        bool move = moveResult == true;

        _folderChangeBusy = true;
        _folderChangeStatus = move ? "Veriler taşınıyor, lütfen bekleyin..." : "Yeni klasöre bağlanılıyor...";
        StateHasChanged();
        try
        {
            await AppPath.ChangeDataRootAsync(selected, moveExistingData: move);
            Snackbar.Add(
                "Veri klasörü değiştirildi. Değişikliklerin tam olarak geçerli olması için uygulamayı yeniden başlatın.",
                Severity.Warning,
                cfg => cfg.VisibleStateDuration = 8000);
            await RefreshFolderSizesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klasör değiştirme hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _folderChangeBusy = false;
            _folderChangeStatus = string.Empty;
            StateHasChanged();
        }
    }

