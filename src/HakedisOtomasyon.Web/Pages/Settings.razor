    private async Task ImportMasterDataAsync()
    {
        var files = await FilePicker.PickFilesAsync("Ana veri paketi|*.zip", multiselect: false);
        if (files.Count == 0) return;

        _backupBusy = true;
        _backupStatus = "Önizleme hazırlanıyor...";
        try
        {
            var preview = await DataBackupService.PreviewImportAsync(files[0]);

            var parameters = new DialogParameters<ImportPreviewDialog>
            {
                { x => x.Preview, preview }
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
            var dialog = await DialogService.ShowAsync<ImportPreviewDialog>("İçe Aktarma Önizlemesi", parameters, options);
            var result = await dialog.Result;

            if (result is null || result.Canceled) return;

            var mode = (ImportMode)result.Data!;
            _backupStatus = "İçe aktarılıyor...";

            var importResult = await DataBackupService.ApplyImportAsync(preview, mode);
            Snackbar.Add(importResult.Summary, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"İçe aktarma hatası: {ex.Message}", Severity.Error);
        }
        finally { _backupBusy = false; _backupStatus = string.Empty; }
    }

    private async Task CreateFullBackupAsync()
    {
        _backupBusy = true;
        _backupStatus = "Tam yedek oluşturuluyor... (büyük dosyalar zaman alabilir)";
        try
        {
            var path = await DataBackupService.CreateFullBackupAsync();
            Snackbar.Add($"Tam yedek başarıyla alındı. → {System.IO.Path.GetFileName(path)}", Severity.Success);
        }
        catch (PartialBackupException pex)
        {
            Snackbar.Add(
                $"Yedek alındı ancak açık olan bazı dosyalar kopyalanamadı. Lütfen açık Excel/görselleri kapatıp tekrar deneyin. → {System.IO.Path.GetFileName(pex.BackupPath)}",
                Severity.Warning,
                cfg => { cfg.VisibleStateDuration = 8000; });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yedekleme hatası: {ex.Message}", Severity.Error);
        }
        finally { _backupBusy = false; _backupStatus = string.Empty; }
    }

    private async Task RestoreFullBackupAsync()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Tam Yedekten Geri Yükle",
            "Geri yükleme için uygulama yeniden başlatılacaktır. Mevcut veriler yedekteki verilerle değiştirilecek. Devam etmek istiyor musunuz?",
            yesText: "Evet, Geri Yükle ve Yeniden Başlat",
            cancelText: "İptal");

        if (confirm != true) return;

        var files = await FilePicker.PickFilesAsync("Tam yedek|*.zip", multiselect: false);
        if (files.Count == 0) return;

        _backupBusy = true;
        _backupStatus = "Geri yükleme planlanıyor...";
        try
        {
            DataBackupService.ScheduleFullRestore(files[0]);

            await DialogService.ShowMessageBox(
                "Uygulama Kapanıyor",
                "Veritabanı kullanımda olduğu için geri yükleme uygulama yeniden başlatılarak tamamlanacaktır. Uygulama şimdi kapanacak. Lütfen uygulamayı tekrar açın — açıldığında geri yükleme otomatik tamamlanacaktır.",
                yesText: "Tamam");

            // Uygulamayı kapat — pending-restore.json marker sayesinde
            // bir sonraki açılışta DbContext başlamadan önce geri yükleme yapılır.
            System.Windows.Application.Current.Shutdown();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Geri yükleme planlanamadı: {ex.Message}", Severity.Error);
        }
        finally { _backupBusy = false; _backupStatus = string.Empty; }
    }

