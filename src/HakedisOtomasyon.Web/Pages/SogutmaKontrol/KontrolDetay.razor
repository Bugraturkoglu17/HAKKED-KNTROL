@page "/discipline/sogutma/kontrol/{Id:int}"
@inject IProgressPaymentCheckService CheckService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Hakediş Kontrol Sonucu</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_check is null)
{
    <MudAlert Severity="Severity.Error">Kontrol kaydı bulunamadı.</MudAlert>
}
else
{
    <HakedisAsamaGostergesi CurrentIndex="1" />

    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <div>
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5" Style="font-weight:700">@_check.ClaimTypeName — @_check.PeriodLabel</MudText>
                @if (!string.IsNullOrEmpty(_check.CategoryLabel))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@_check.CategoryLabel</MudChip>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_check.CompanyName · @_check.Region · @_check.OriginalFileName</MudText>
        </div>
        <MudStack Row Spacing="1">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/discipline/sogutma/kontrol">Kontrol Merkezi</MudButton>
            @if (_pendingCount > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RuleFolder"
                           OnClick="OpenMatchQueue">
                    Eşleşme Kontrolü (@_pendingCount)
                </MudButton>
            }
            @if (_bulkCorrectableCount > 0)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PriceCheck"
                           OnClick="BulkCorrectPricesAsync">
                    Tüm Kesin Birim Fiyat Hatalarını Düzelt (@_bulkCorrectableCount)
                </MudButton>
            }
        </MudStack>
    </MudStack>

    @if (_pendingCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            @_pendingCount kalem tahmini eşleşme onayı bekliyor. Kontrolü tamamlamadan önce "Eşleşme Kontrolü" ile karar verin.
        </MudAlert>
    }

    <MudGrid Spacing="1" Class="mb-2">
        <MudItem xs="6" md="2"><KpiStat Label="Toplam Kalem" Value="@_check.TotalItemCount.ToString()" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Uygun" Value="@_check.UygunCount.ToString()" Color="Color.Success" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Onay Bekleyen" Value="@_check.OnayBekliyorCount.ToString()" Color="Color.Warning" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Hatalı" Value="@_check.HataliCount.ToString()" Color="Color.Error" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Eşleşmeyen" Value="@_check.EslesmeyenCount.ToString()" Color="Color.Error" /></MudItem>
        <MudItem xs="6" md="2">
            <KpiStat Label="Toplam Fark" Value="@($"{_check.Difference:N2} TL")" Color="@(_check.Difference > 0 ? Color.Error : Color.Success)" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="1" Class="mb-2">
        <MudItem xs="6" md="4">
            <MudPaper Class="pa-1 text-center" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Firma Hakediş Toplamı</MudText>
                <MudText Typo="Typo.subtitle1" Style="font-weight:600">@_check.CompanyTotal.ToString("N2") TL</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Class="pa-1 text-center" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Bizim Hesapladığımız Toplam</MudText>
                <MudText Typo="Typo.subtitle1" Style="font-weight:600">@_check.CalculatedTotal.ToString("N2") TL</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Class="pa-1 text-center" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Kullanılan Ort. EUR/TL</MudText>
                <MudText Typo="Typo.subtitle1" Style="font-weight:600">@(_check.ExchangeRateEur?.ToString("N4") ?? "—")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="2" Style="overflow-x:auto;max-width:100%">
        <MudTable Items="@_items" Dense Hover Class="kontrol-tablo-kompakt"
                  Filter="new Func<ProgressPaymentCheckItemDto, bool>(FilterFunc)" RowsPerPage="50">
            <ToolBarContent>
                <MudGrid Spacing="1" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_searchText" Placeholder="Ara..."
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate Dense Clearable Variant="Variant.Outlined" Class="mt-0" />
                    </MudItem>
                    <MudItem xs="12" md="9">
                        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                                    SelectedValue="_statusFilter" SelectedValueChanged="OnFilterChanged"
                                    Style="flex-wrap:wrap">
                            <MudChip T="string" Value="@("all")" Size="Size.Small">Tümü</MudChip>
                            <MudChip T="string" Value="@("uygun")" Size="Size.Small" Color="Color.Success">Uygun</MudChip>
                            <MudChip T="string" Value="@("hatali")" Size="Size.Small" Color="Color.Error">Hatalı</MudChip>
                            <MudChip T="string" Value="@("eslesmeyen")" Size="Size.Small" Color="Color.Error">Eşleşmeyen</MudChip>
                            <MudChip T="string" Value="@("onaybekleyen")" Size="Size.Small" Color="Color.Warning">Onay Bekleyen</MudChip>
                        </MudChipSet>
                    </MudItem>
                </MudGrid>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Durum</MudTh>
                <MudTh>Mağaza</MudTh>
                <MudTh>Malzeme Adı (Firma)</MudTh>
                <MudTh>Eşleşen Kalem</MudTh>
                <MudTh>Mik.</MudTh>
                <MudTh>Bir.</MudTh>
                <MudTh>Onaylı BF</MudTh>
                <MudTh>Firma BF</MudTh>
                <MudTh>Hesaplanan</MudTh>
                <MudTh>Firma Tutarı</MudTh>
                <MudTh>Fark</MudTh>
                <MudTh>Not</MudTh>
                <MudTh>İşlem</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.ControlStatus)">@context.ControlStatusLabel</MudChip></MudTd>
                <MudTd>
                    <MudTooltip Text="@context.StoreName">
                        <MudText Typo="Typo.caption" Style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">@context.StoreName</MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd>
                    <MudTooltip Text="@context.OriginalMaterialName">
                        <MudText Typo="Typo.caption" Style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                            @context.OriginalMaterialName
                        </MudText>
                    </MudTooltip>
                    @if (!string.IsNullOrWhiteSpace(context.OriginalMaterialSpec))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">@context.OriginalMaterialSpec</MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudTooltip Text="@context.MatchedMaterialName">
                        <MudText Typo="Typo.caption" Style="max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">@context.MatchedMaterialName</MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd>@context.Quantity.ToString("0.####")</MudTd>
                <MudTd>@context.Unit</MudTd>
                <MudTd>@(context.ApprovedUnitPriceTry?.ToString("N2") ?? "—")</MudTd>
                <MudTd>@context.CompanyUnitPrice.ToString("N2")</MudTd>
                <MudTd>@(context.CalculatedLineTotal?.ToString("N2") ?? "—")</MudTd>
                <MudTd>@context.CompanyLineTotal.ToString("N2")</MudTd>
                <MudTd Style="@FarkStyle(context.Difference)">@(context.Difference?.ToString("N2") ?? "—")</MudTd>
                <MudTd>
                    <MudTooltip Text="@context.ControlNote">
                        <MudText Typo="Typo.caption" Style="max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                            @context.ControlNote
                        </MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd Style="white-space:nowrap">
                    <MudIconButton Icon="@Icons.Material.Filled.FindReplace" Size="Size.Small" Title="Yeniden Eşleştir"
                                   OnClick="@(() => RematchAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Miktarı Düzelt"
                                   OnClick="@(() => EditQuantityAsync(context))" />
                    <MudIconButton Icon="@(context.IsExcluded ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                   Size="Size.Small" Title="Kontrol Dışı Bırak/Al" OnClick="@(() => ToggleExcludeAsync(context))" />

                    @if (context.ControlStatus == CheckItemControlStatus.BirimFiyatBulunamadi)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Color="Color.Primary"
                                       Title="Yeni Kalem Ekle" OnClick="@(() => AddNewItemAsync(context))" />
                    }
                    @if (context.ControlStatus == CheckItemControlStatus.FiyatHatasi)
                    {
                        @if (context.PriceCorrectionApplied)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Warning"
                                           Title="Düzeltmeyi Geri Al" OnClick="@(() => TogglePriceCorrectionAsync(context))" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Build" Size="Size.Small" Color="Color.Error"
                                           Title="Düzelt" OnClick="@(() => TogglePriceCorrectionAsync(context))" />
                        }
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    </MudPaper>

    <MudStack Row Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="ProceedToFormReviewAsync">
            Kaydet ve Form Kontrolüne Geç
        </MudButton>
    </MudStack>
}

<style>
    /* Tabloyu daha az yer kaplayacak şekilde sıkılaştırır — hücre iç boşlukları
       ve yazı boyutu küçültülerek daha çok sütun ekrana kaydırma ihtiyacı
       olmadan sığar. */
    .kontrol-tablo-kompakt .mud-table-cell {
        padding: 4px 8px !important;
        font-size: 0.75rem !important;
    }

    .kontrol-tablo-kompakt .mud-table-cell .mud-chip {
        height: 22px;
        font-size: 0.6875rem;
    }

    .kontrol-tablo-kompakt .mud-icon-button {
        padding: 4px;
    }

    .kontrol-tablo-kompakt .mud-icon-button svg {
        font-size: 1.1rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private ProgressPaymentCheckDto? _check;
    private List<ProgressPaymentCheckItemDto> _items = new();
    private bool _loading = true;
    private string _searchText = string.Empty;
    private string _statusFilter = "all";
    private int _bulkCorrectableCount;

    private int _pendingCount => _items.Count(i => i.MatchStatus == MaterialMatchStatus.FuzzyPending && !i.IsExcluded);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _check = await CheckService.GetByIdAsync(Id);
        _items = _check is null ? new() : await CheckService.GetItemsAsync(Id);
        _bulkCorrectableCount = _check is null ? 0 : await CheckService.GetBulkPriceCorrectionPreviewCountAsync(Id);
        _loading = false;
    }

    private void OnFilterChanged(string? value)
    {
        _statusFilter = value ?? "all";
    }

    private bool FilterFunc(ProgressPaymentCheckItemDto i)
    {
        if (_statusFilter == "uygun" && i.ControlStatus != CheckItemControlStatus.Uygun) return false;
        if (_statusFilter == "hatali" && i.ControlStatus is not (CheckItemControlStatus.FiyatHatasi or CheckItemControlStatus.BirimUyusmazligi)) return false;
        if (_statusFilter == "eslesmeyen" && i.ControlStatus != CheckItemControlStatus.BirimFiyatBulunamadi) return false;
        if (_statusFilter == "onaybekleyen" && i.ControlStatus != CheckItemControlStatus.OnayBekliyor) return false;

        if (!string.IsNullOrEmpty(_searchText))
        {
            var q = _searchText.Trim();
            return i.OriginalMaterialName.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (i.StoreName?.Contains(q, StringComparison.OrdinalIgnoreCase) == true);
        }
        return true;
    }

    private async Task OpenMatchQueue()
    {
        if (_check is null) return;
        var parameters = new DialogParameters
        {
            ["CheckId"] = Id,
            ["UnitPriceListId"] = _check.UnitPriceListId,
            ["CompanyName"] = _check.CompanyName,
        };
        var dialog = await DialogService.ShowAsync<MaterialMatchQueueDialog>("Eşleşme Kontrolü", parameters);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task RematchAsync(ProgressPaymentCheckItemDto item)
    {
        if (_check is null) return;
        var parameters = new DialogParameters
        {
            ["UnitPriceListId"] = _check.UnitPriceListId,
            ["InitialQuery"] = item.OriginalMaterialName,
        };
        var dialog = await DialogService.ShowAsync<ManualMaterialSearchDialog>("Doğru Malzemeyi Seçin", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is UnitPriceItemDto selected)
        {
            await CheckService.ResolveMatchAsync(Id, new List<int> { item.Id }, selected.Id, saveAsAlias: true, _check.CompanyName);
            await LoadAsync();
            Snackbar.Add("Eşleştirme güncellendi.", Severity.Success);
        }
    }

    private async Task EditQuantityAsync(ProgressPaymentCheckItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["MaterialName"] = item.OriginalMaterialName,
            ["CurrentQuantity"] = item.Quantity,
        };
        var dialog = await DialogService.ShowAsync<QuantityEditDialog>("Miktarı Düzelt", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is decimal newQty)
        {
            await CheckService.CorrectQuantityAsync(item.Id, newQty);
            await LoadAsync();
            Snackbar.Add("Miktar güncellendi.", Severity.Success);
        }
    }

    private async Task ToggleExcludeAsync(ProgressPaymentCheckItemDto item)
    {
        await CheckService.ExcludeItemAsync(item.Id, !item.IsExcluded);
        await LoadAsync();
    }

    private async Task AddNewItemAsync(ProgressPaymentCheckItemDto item)
    {
        if (_check is null) return;

        var candidates = await CheckService.FindSimilarCandidatesAsync(item.Id);
        var strong = candidates.FirstOrDefault(c => c.Confidence >= 0.55m && !c.SpecMismatchWarning);
        if (strong != null)
        {
            var label = string.IsNullOrWhiteSpace(strong.Spec) ? strong.MaterialName : $"{strong.MaterialName} — {strong.Spec}";
            var msg = $"\"{item.OriginalMaterialName}\" için sistemde benzer bir ürün bulundu: \"{label}\" ({strong.Price:N2} {strong.Currency}). Benzerlik: %{strong.Confidence * 100:N0}. Teknik ölçüler farklıysa ayrı ürün olarak eklemeye devam edebilirsiniz.";
            var choice = await DialogService.ShowMessageBox("Benzer Ürün Bulundu", msg,
                yesText: "Bu Ürünle Eşleştir", noText: "Yeni Kalem Olarak Ekle", cancelText: "İptal");
            if (choice is null) return;
            if (choice == true)
            {
                await CheckService.ResolveMatchAsync(Id, new List<int> { item.Id }, strong.UnitPriceItemId, saveAsAlias: true, _check.CompanyName);
                await LoadAsync();
                Snackbar.Add("Mevcut ürünle eşleştirildi.", Severity.Success);
                return;
            }
        }

        // Firmanın hakedişte yazdığı fiyatla önceden doldurulur — kullanıcı burada düzeltip kaydedebilir.
        var dto = new UnitPriceItemDto
        {
            MaterialName = item.OriginalMaterialName,
            Spec = item.OriginalMaterialSpec,
            Unit = item.Unit,
            Price = item.CompanyUnitPrice,
            Currency = "TRY",
        };
        var parameters = new DialogParameters { ["Item"] = dto };
        var dialog = await DialogService.ShowAsync<CoolingPriceItemEditDialog>("Yeni Birim Fiyat Kalemi", parameters);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not UnitPriceItemDto newItem) return;

        await CheckService.CreateAndMatchNewItemAsync(Id, new List<int> { item.Id }, newItem, _check.CompanyName, "YeniKalemEkle");
        await LoadAsync();
        Snackbar.Add("Yeni birim fiyat kalemi eklendi ve eşleştirildi.", Severity.Success);
    }

    private async Task TogglePriceCorrectionAsync(ProgressPaymentCheckItemDto item)
    {
        var applying = !item.PriceCorrectionApplied;
        await CheckService.SetPriceCorrectionAsync(item.Id, applying);
        await LoadAsync();
        Snackbar.Add(applying ? "Fiyat düzeltmesi işaretlendi." : "Düzeltme geri alındı.", Severity.Success);
    }

    private async Task BulkCorrectPricesAsync()
    {
        var count = await CheckService.GetBulkPriceCorrectionPreviewCountAsync(Id);
        if (count == 0)
        {
            Snackbar.Add("Düzeltilecek kesin fiyat hatası bulunamadı.", Severity.Info);
            return;
        }
        var confirm = await DialogService.ShowMessageBox("Toplu Birim Fiyat Düzeltmesi",
            $"{count} satırdaki birim fiyat onaylı fiyatla değiştirilecektir. Onaylıyor musunuz?",
            yesText: "Evet, Düzelt", cancelText: "İptal");
        if (confirm != true) return;

        var applied = await CheckService.ApplyBulkPriceCorrectionAsync(Id);
        await LoadAsync();
        Snackbar.Add($"{applied} satırda birim fiyat düzeltmesi uygulandı.", Severity.Success);
    }

    private async Task ProceedToFormReviewAsync()
    {
        var unresolved = await CheckService.GetUnresolvedPriceItemCountAsync(Id);
        if (unresolved > 0)
        {
            var confirm = await DialogService.ShowMessageBox("Çözülmemiş Kalemler Var",
                $"{unresolved} eşleşmeyen/onay bekleyen kalem bulunmaktadır. Yine de form kontrolüne geçmek istiyor musunuz?",
                yesText: "Evet, Devam Et", cancelText: "İptal");
            if (confirm != true) return;
        }

        await CheckService.SetStageAsync(Id, HakedisControlStage.PriceReviewCompleted);
        Nav.NavigateTo($"/discipline/sogutma/kontrol/{Id}/form");
    }

    private static string FarkStyle(decimal? diff) => diff switch
    {
        > 0 => "color:var(--mud-palette-error);font-weight:600",
        < 0 => "color:var(--mud-palette-warning);font-weight:600",
        _ => ""
    };

    private static Color StatusColor(CheckItemControlStatus s) => s switch
    {
        CheckItemControlStatus.Uygun => Color.Success,
        CheckItemControlStatus.OnayBekliyor => Color.Warning,
        CheckItemControlStatus.KontrolDisi => Color.Default,
        CheckItemControlStatus.KontrolGerekli => Color.Info,
        _ => Color.Error
    };
}
