@page "/discipline/sogutma/kontrol/{Id:int}/form"
@inject IAiAnalysisPipelineService Pipeline
@inject IProgressPaymentCheckService CheckService
@inject SogutmaHakedisKontrol.Application.Interfaces.IFilePickerService FilePicker
@inject IPdfPageRasterizer PdfRasterizer
@inject IAiVisionClient VisionClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Form Kontrolü</PageTitle>

<HakedisAsamaGostergesi CurrentIndex="2" />

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_check is null)
{
    <MudAlert Severity="Severity.Error">Kontrol kaydı bulunamadı.</MudAlert>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:700">Form Kontrolü</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Seçilen hakediş türü: <b>@(_check.CategoryLabel ?? "Belirtilmemiş")</b> — @_check.CompanyName · @_check.Region · @_check.PeriodLabel
            </MudText>
        </div>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="@($"/discipline/sogutma/kontrol/{Id}")">
            Fiyat Kontrolüne Dön
        </MudButton>
    </MudStack>
    <MudDivider Class="my-3" />

    @if (_initError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.body2" Style="font-weight:600">Form kontrolü başlatılamadı</MudText>
            <MudText Typo="Typo.caption" Style="white-space:pre-wrap">@_initError</MudText>
        </MudAlert>
    }

    <MudPaper Class="pa-3 mb-4" Outlined>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Style="font-weight:600">Servis ve Bakım Formlarını Yükle</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
            Tek bir dosya alanına tüm servis/bakım formlarını (PDF, JPG, PNG) ekleyin — belge türünü AI
            formun üzerindeki başlıktan kendisi ayırt eder, ayrı ayrı yüklemenize gerek yoktur.
            Hakediş Exceli tekrar yüklenmez; AI, formdaki <b>form numarasını</b> önceki aşamada yüklenen
            hakediş satırlarıyla eşleştirir.
        </MudText>

        <FileDropZone OnFilesSelected="AddFilesAsync" />

        @foreach (var f in _files)
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1 mt-2">
                <div>
                    <MudText Typo="Typo.body2">@f.Name</MudText>
                    <MudText Typo="Typo.caption" Color="@FileStatusColor(f)">@FileStatusLabel(f)</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => RemoveFile(f))" />
            </MudStack>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        @if (_running)
        {
            <MudText Typo="Typo.subtitle1" Style="font-weight:600" Class="mb-2">Hakediş Analizi Devam Ediyor</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@_progressMessage</MudText>
            @if (_progressTotal.HasValue && _progressTotal.Value > 0)
            {
                <MudProgressLinear Value="@ProgressPercent" Color="Color.Primary" Class="mb-1" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@ProgressCounterLabel</MudText>
            }
            else
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }
        }
        else
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="flex-wrap:wrap" Spacing="2">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="@OpenAiStatusColor" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:600">@VisionClient.ProviderLabel</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@OpenAiStatusLabel</MudText>
                    </div>
                </MudStack>
                <MudStack Row Spacing="2">
                    @if (_job != null)
                    {
                        <MudButton Variant="Variant.Text" OnClick="RetryFailedAsync" Disabled="@RetryButtonDisabled">
                            @RetryButtonLabel
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                               Disabled="@AnalyzeButtonDisabled" OnClick="RunAnalysisAsync">
                        Yapay Zeka ile Kontrol Et
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (_openAiConfigured == false)
            {
                <MudAlert Severity="Severity.Error" Dense Class="mt-3">
                    AI sağlayıcısı yapılandırılmamış. Kontrol çalıştırılamaz.
                </MudAlert>
            }
        }
    </MudPaper>

    @if (_job == null)
    {
        <MudAlert Severity="Severity.Info" Dense Class="mb-4">Henüz bir analiz çalıştırılmadı.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-3 mb-3" Outlined>
            <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3">
                <MudStack Row Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Variant="Variant.Text" Size="Size.Small">@UygunCountLabel Uygun</MudChip>
                    <MudChip T="string" Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Variant="Variant.Text" Size="Size.Small">@UygunDegilCountLabel Uygun Değil</MudChip>
                    <MudChip T="string" Icon="@Icons.Material.Filled.RemoveCircleOutline" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small">@EksikCountLabel Eksik</MudChip>
                    <MudChip T="string" Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small">@ManuelKontrolCountLabel Manuel Kontrol</MudChip>
                </MudStack>
                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@StoreMatchIcon" Color="@StoreMatchColor" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@StoreMatchSummaryLabel</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showStoreDetails = !_showStoreDetails)">
                        @(_showStoreDetails ? "Gizle" : "Detaylar")
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (_showStoreDetails)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">@PageBreakdownLabel</MudText>
                @if (_storeIssues.Count > 0)
                {
                    @foreach (var issue in _storeIssues)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">🔴 @issue.Message</MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">Tüm formlar için mutabakat tam.</MudText>
                }
            }
        </MudPaper>

        @if (_manualReviewPages.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense>
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Style="font-weight:600">@ManualReviewHeaderLabel</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showManualReview = !_showManualReview)">
                        @(_showManualReview ? "Gizle" : "Göster")
                    </MudButton>
                </MudStack>
                @if (_showManualReview)
                {
                    @foreach (var p in _manualReviewPages)
                    {
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1 mt-2">
                            <MudText Typo="Typo.caption">@ManualReviewPageLabel(p)</MudText>
                        </MudStack>
                        @foreach (var m in ManualReviewMaterials(p))
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="ml-4 mb-1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ManualReviewMaterialLabel(m)</MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CorrectMaterialAsync(m))">Düzelt</MudButton>
                            </MudStack>
                        }
                    }
                }
            </MudAlert>
        }

        <MudPaper Elevation="1" Style="overflow-x:auto;max-width:100%">
            <MudTable Items="@SortedResults" Dense Hover Filter="@TableFilter" RowsPerPage="25">
                <ToolBarContent>
                    <MudGrid Spacing="1" AlignItems="AlignItems.Center">
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_searchText" Placeholder="Mağaza veya kalem ara..."
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate Dense Clearable Variant="Variant.Outlined" Class="mt-0" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                                        SelectedValue="_statusFilter" SelectedValueChanged="OnStatusFilterChanged"
                                        Style="flex-wrap:wrap">
                                <MudChip T="string" Value="@AllFilterValue" Size="Size.Small">Tümü</MudChip>
                                <MudChip T="string" Value="@UygunFilterValue" Size="Size.Small" Color="Color.Success">Uygun</MudChip>
                                <MudChip T="string" Value="@UygunDegilFilterValue" Size="Size.Small" Color="Color.Error">Uygun Değil</MudChip>
                                <MudChip T="string" Value="@EksikFilterValue" Size="Size.Small" Color="Color.Warning">Eksik</MudChip>
                                <MudChip T="string" Value="@FazlaFilterValue" Size="Size.Small" Color="Color.Warning">Fazla</MudChip>
                                <MudChip T="string" Value="@ManuelKontrolFilterValue" Size="Size.Small" Color="Color.Warning">Manuel Kontrol</MudChip>
                            </MudChipSet>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudSwitch T="bool" @bind-Value="_onlyProblems" Color="Color.Error" Label="Yalnızca Sorunluları Göster" />
                        </MudItem>
                    </MudGrid>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Mağaza</MudTh>
                    <MudTh>Tarih</MudTh>
                    <MudTh>Form No</MudTh>
                    <MudTh>Kontrol Kalemi</MudTh>
                    <MudTh>Değer</MudTh>
                    <MudTh>Sonuç</MudTh>
                    <MudTh>Açıklama</MudTh>
                    <MudTh>İşlem</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.StoreLabel</MudTd>
                    <MudTd>@VisitDateLabel(context)</MudTd>
                    <MudTd>@FormReferenceLabel(context)</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>
                        @if (string.IsNullOrEmpty(context.FormValue) || context.FormValue == context.HakedisValue)
                        {
                            <MudText Typo="Typo.body2" Color="@ValueColor(context)">@ValueDisplay(context)</MudText>
                        }
                        else
                        {
                            <MudTooltip Text="@($"Servis Formu: {context.FormValue}")">
                                <MudText Typo="Typo.body2" Color="@ValueColor(context)" Style="cursor:help;border-bottom:1px dotted currentColor;display:inline-block">
                                    @ValueDisplay(context)
                                </MudText>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">@ResultIcon(context.Status) @ResultLabel(context.Status)</MudText>
                            @if (context.UserOverridden)
                            {
                                <MudTooltip Text="@($"AI sonucu: {ResultLabel(context.OriginalStatusLabel ?? string.Empty)}")">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                                             Icon="@Icons.Material.Filled.Verified">Kontrol Edildi</MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudTooltip Text="@context.Explanation">
                            <MudText Typo="Typo.caption" Style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                                @context.Explanation
                            </MudText>
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        @if (context.UserOverridden)
                        {
                            <MudTooltip Text="Onayı geri al">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                               Color="Color.Default" OnClick="@(() => RevertOverrideAsync(context))" />
                            </MudTooltip>
                        }
                        else if (context.Status != UygunFilterValue)
                        {
                            <MudTooltip Text="Onay ver">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                               Color="Color.Success" OnClick="@(() => OverrideResultAsync(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
                <NoRecordsContent><MudAlert Severity="Severity.Info" Dense>Kayıt yok.</MudAlert></NoRecordsContent>
            </MudTable>
        </MudPaper>
    }

    <MudStack Row Justify="Justify.SpaceBetween" Class="mt-4">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="@($"/discipline/sogutma/kontrol/{Id}")">
            Fiyat Kontrolüne Dön
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="ProceedToResultsAsync">
            Kaydet ve Sonuca Geç
        </MudButton>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private ProgressPaymentCheckDto? _check;
    private string? _initError;

    private List<PickedFile> _files = new();

    private bool _openAiConfigured = true;

    private AiAnalysisJobDto? _job;
    private List<AiDocumentPageDto> _pages = new();
    private List<AiDocumentPageDto> _manualReviewPages = new();
    private List<AiComparisonResultDto> _results = new();
    private List<StoreReconciliationIssueDto> _storeIssues = new();
    private bool _showStoreDetails;
    private bool _showManualReview;

    private bool _running;
    private string _progressMessage = string.Empty;
    private int? _progressCurrent;
    private int? _progressTotal;

    private string _searchText = string.Empty;
    private string _statusFilter = "all";
    private bool _onlyProblems;

    private const string AllFilterValue = "all";
    private const string UygunFilterValue = "Uygun";
    private const string UygunDegilFilterValue = "UygunDegil";
    private const string EksikFilterValue = "Eksik";
    private const string FazlaFilterValue = "Fazla";
    private const string ManuelKontrolFilterValue = "ManuelKontrol";

    private class PickedFile
    {
        public string Path { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public long Size { get; set; }
        public int PageCount { get; set; }
        public bool HasError { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _check = await CheckService.GetByIdAsync(Id);
            if (_check != null)
            {
                DetectOpenAiConfigured();
                await LoadJobAsync();
                await CheckService.SetStageAsync(Id, HakedisControlStage.FormReviewInProgress);
            }
        }
        catch (Exception ex)
        {
            _initError = ex.ToString();
        }
        finally
        {
            _loading = false;
        }
    }

    private void DetectOpenAiConfigured()
    {
        _openAiConfigured = VisionClient.IsConfigured;
    }

    private async Task LoadJobAsync()
    {
        _job = await Pipeline.GetLatestJobForCheckAsync(Id);
        if (_job == null) return;
        _pages = await Pipeline.GetPagesAsync(_job.Id);
        // Gaz Kullanım / Glikol Kullanım'da yalnızca tek bir kalem (gaz kg / glikol kg) + form no/mağaza/
        // tarih doğrulanır — bu serbest metin uyarı listesi AI'nin ham OCR-kalite notlarından geliyor ve
        // ilgisiz alanları (personel adı, diğer malzemeler) da içerebiliyor; kategoriye özel gerçek
        // sorunların hepsi zaten aşağıdaki karşılaştırma tablosunda kendi açıklamasıyla görünüyor, bu
        // yüzden bu iki kategoride ayrı bir "manuel kontrol" uyarı kutusu gösterilmez.
        var isSingleItemCategory = _check?.Category is HakedisCategory.GasUsage or HakedisCategory.GlycolUsage;
        _manualReviewPages = isSingleItemCategory ? new List<AiDocumentPageDto>() : _pages.Where(p => p.RequiresManualReview).ToList();
        _results = await Pipeline.GetComparisonResultsAsync(_job.Id);
        _storeIssues = await Pipeline.GetStoreReconciliationIssuesAsync(_job.Id);
    }

    // Form numarası hiç okunamadı/Excel'de bulunamadı/mükerrer türü hatalar belirli bir hakediş satırına
    // bağlı DEĞİLDİR (checkItemId yok) — bu yüzden detay tablosunda değil, yalnızca üst Form Mutabakatı
    // özetinde gösterilir (bkz. FormNumberMatcher.PageOnlyErrorDescriptions ile aynı liste, senkron tutulmalı).
    private static readonly string[] PageOnlyErrorDescriptions =
        { "Form Numarası Okunamadı", "Form Hakedişte Bulunamadı", "Mükerrer Form Numarası" };

    private IEnumerable<AiComparisonResultDto> SortedResults => _results
        .Where(r => !PageOnlyErrorDescriptions.Contains(r.Description))
        .OrderBy(r => r.StoreLabel).ThenBy(r => r.VisitDate);

    private bool CanProceedToAnalysis => _files.Count > 0 && _files.All(f => !f.HasError);
    private bool AnalyzeButtonDisabled => !CanProceedToAnalysis || !_openAiConfigured;
    private bool RetryButtonDisabled => _job == null || _job.FailedPages == 0;
    private string RetryButtonLabel => _job == null ? string.Empty : $"Başarısız Sayfaları Yeniden Dene ({_job.FailedPages})";

    private Color OpenAiStatusColor => _openAiConfigured ? Color.Success : Color.Error;
    private string OpenAiStatusLabel => _openAiConfigured ? "Bağlı" : "Yapılandırılmamış";

    private double ProgressPercent
    {
        get
        {
            if (_progressTotal is null or 0) return 0;
            var current = _progressCurrent ?? 0;
            return 100.0 * current / _progressTotal.Value;
        }
    }

    private string ProgressCounterLabel => $"{_progressCurrent ?? 0} / {_progressTotal ?? 0}";

    private static Color FileStatusColor(PickedFile f) => f.HasError ? Color.Error : Color.Secondary;
    private static string FileStatusLabel(PickedFile f) =>
        f.HasError ? "Dosya okunamadı" : $"{f.PageCount} sayfa — {FormatSize(f.Size)} — Analize hazır";

    private void RemoveFile(PickedFile f) => _files.Remove(f);

    private async Task AddFilesAsync(IReadOnlyList<string> paths)
    {
        foreach (var path in paths)
        {
            if (_files.Any(f => f.Path == path)) continue;
            _files.Add(await BuildPickedFileAsync(path));
        }
    }

    private async Task<PickedFile> BuildPickedFileAsync(string path)
    {
        var file = new PickedFile { Path = path, Name = Path.GetFileName(path) };
        try
        {
            file.Size = new FileInfo(path).Length;
            var ext = Path.GetExtension(path).ToLowerInvariant();
            file.PageCount = ext == ".pdf" ? PdfRasterizer.GetPageCount(await File.ReadAllBytesAsync(path)) : 1;
        }
        catch
        {
            file.HasError = true;
            Snackbar.Add($"{file.Name} okunamadı. Dosya bozuk olabilir.", Severity.Error);
        }
        return file;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("0.#") + " KB";
        return (bytes / 1024.0 / 1024.0).ToString("0.#") + " MB";
    }

    // Tek dosya alanı: tüm belgeler serviceForms olarak gönderilir — sayfa türü zaten
    // içerik bazlı (pozisyon bağımsız) sınıflandırıldığı için ayrı bir "bakım formu" alanına gerek yok.
    private async Task RunAnalysisAsync()
    {
        _running = true;
        _progressMessage = "Başlatılıyor...";
        _progressCurrent = null;
        _progressTotal = null;
        StateHasChanged();

        try
        {
            var payload = new List<(byte[], string)>();
            foreach (var f in _files)
                payload.Add((await File.ReadAllBytesAsync(f.Path), f.Name));

            var progress = new Progress<AiJobProgressUpdate>(OnProgressUpdate);
            _job = await Pipeline.RunAsync(Id, payload, null, null, progress);

            await LoadJobAsync();
            Snackbar.Add("Yapay zeka kontrolü tamamlandı.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Analiz hatası: " + ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private void OnProgressUpdate(AiJobProgressUpdate u)
    {
        _progressMessage = u.Message;
        _progressCurrent = u.Current;
        _progressTotal = u.Total;
        InvokeAsync(StateHasChanged);
    }

    private async Task RetryFailedAsync()
    {
        if (_job == null) return;
        _running = true;
        StateHasChanged();
        try
        {
            var progress = new Progress<AiJobProgressUpdate>(u => { _progressMessage = u.Message; InvokeAsync(StateHasChanged); });
            _job = await Pipeline.RetryFailedPagesAsync(_job.Id, progress);
            await LoadJobAsync();
            Snackbar.Add("Yeniden deneme tamamlandı.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Yeniden deneme hatası: " + ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task CorrectMaterialAsync(AiPageMaterialDto material)
    {
        var parameters = new DialogParameters { ["Material"] = material };
        var dialog = await DialogService.ShowAsync<AiMaterialCorrectionDialog>("Malzeme Miktarını Düzelt", parameters);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not ValueTuple<decimal?, string?, string?> correction) return;
        await Pipeline.CorrectMaterialAsync(material.Id, correction.Item1, correction.Item2, correction.Item3);
        await LoadJobAsync();
        Snackbar.Add("Malzeme güncellendi.", Severity.Success);
    }

    private async Task OverrideResultAsync(AiComparisonResultDto result)
    {
        await Pipeline.OverrideResultStatusAsync(result.Id, note: null);
        await LoadJobAsync();
        Snackbar.Add("Uygun olarak onaylandı.", Severity.Success);
    }

    private async Task RevertOverrideAsync(AiComparisonResultDto result)
    {
        await Pipeline.RevertOverrideAsync(result.Id);
        await LoadJobAsync();
        Snackbar.Add("Onay geri alındı.", Severity.Info);
    }

    private void OnStatusFilterChanged(string? value) => _statusFilter = value ?? AllFilterValue;

    private Func<AiComparisonResultDto, bool> TableFilter => FilterResult;

    private bool FilterResult(AiComparisonResultDto r)
    {
        if (_onlyProblems && r.Status == UygunFilterValue) return false;
        if (_statusFilter != AllFilterValue && r.Status != _statusFilter) return false;
        if (string.IsNullOrEmpty(_searchText)) return true;
        var q = _searchText.Trim();
        return r.StoreLabel.Contains(q, StringComparison.OrdinalIgnoreCase) || r.Description.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private static string VisitDateLabel(AiComparisonResultDto r) => r.VisitDate?.ToString("dd.MM.yyyy") ?? "-";
    private static string FormReferenceLabel(AiComparisonResultDto r) => r.FormReference ?? "-";

    // Not: Gaz Kullanım/Glikol Kullanım'da manuel kontrol listesi zaten LoadJobAsync'te tamamen
    // boşaltılıyor (yalnızca tek kalem önemli, bkz. yukarısı) — bu yüzden burada kategoriye özel
    // filtreye gerek yok, _manualReviewPages o kategorilerde hiç dolmuyor.
    private static IEnumerable<AiPageMaterialDto> ManualReviewMaterials(AiDocumentPageDto p) => p.Materials.Where(m => m.RequiresManualReview);

    // Form numarası güçlü bir anahtar olduğu için mağaza adı önce hakedişten (ResolvedStoreLabel)
    // çözülmeye çalışılır — formdaki mağaza yazısı el yazısıyla belirsiz olsa bile kullanıcı hangi
    // mağazaya bakması gerektiğini "Sayfa X" yerine doğrudan mağaza adından görür.
    private static string ManualReviewPageLabel(AiDocumentPageDto p)
    {
        var store = p.ResolvedStoreLabel ?? p.StoreNameRaw ?? p.StoreCodeRaw ?? "Mağaza tespit edilemedi";
        var docType = DocTypeLabel(p.DocumentType);
        var source = p.SourceFileName ?? (p.SourceKind == "ServiceForm" ? "Servis Formu Dosyası" : "Bakım Formu Dosyası");
        var storeNote = p.ResolvedStoreLabel != null && string.IsNullOrWhiteSpace(p.StoreNameRaw) && string.IsNullOrWhiteSpace(p.StoreCodeRaw)
            ? " (form no ile hakedişten bulundu — formda mağaza bilgisi kısmen okunamadı)"
            : string.Empty;
        return $"{store}{storeNote} — {docType}, {source} Sayfa {p.PageNumber} — {p.ManualReviewReason}";
    }

    private static string ManualReviewMaterialLabel(AiPageMaterialDto m) => $"{m.RawName} miktarı manuel kontrol edilmeli";

    private string ManualReviewHeaderLabel => $"Manuel kontrol gereken belgeler ({_manualReviewPages.Count})";

    private string UygunCountLabel => _job?.UygunItemCount.ToString() ?? "0";
    private string UygunDegilCountLabel => _job?.UygunDegilItemCount.ToString() ?? "0";
    private string EksikCountLabel => _job?.EksikItemCount.ToString() ?? "0";
    private string ManuelKontrolCountLabel => _results.Count(r => r.Status == ManuelKontrolFilterValue).ToString();

    private int StoreMatchProblemCount => _job == null ? 0 : _job.EksikFormSayisi + _job.FazlaFormSayisi + _job.MukerrerZiyaretSayisi;
    private Color StoreMatchColor => StoreMatchProblemCount > 0 ? Color.Warning : Color.Success;
    private string StoreMatchIcon => StoreMatchProblemCount > 0 ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.CheckCircle;
    private string StoreMatchSummaryLabel
    {
        get
        {
            if (_job == null) return string.Empty;
            var baseLabel = $"Form Mutabakatı: {_job.EslesenFormSayisi}/{_job.BeklenenFormSayisi} form eşleşti";
            return StoreMatchProblemCount > 0 ? $"{baseLabel} · {StoreMatchProblemCount} sorun" : baseLabel;
        }
    }

    // AI sayfa dağılımı + reddedilen servis ücreti — "Detaylar" genişletilince gösterilen tek satır özet.
    private string PageBreakdownLabel
    {
        get
        {
            if (_job == null) return string.Empty;
            var parts = new List<string> { $"{_job.ClassifiedServiceFormPageCount} servis formu" };
            if (_job.ClassifiedMaintenancePageCount > 0) parts.Add($"{_job.ClassifiedMaintenancePageCount} bakım formu");
            if (_job.SummaryPageCount > 0) parts.Add($"{_job.SummaryPageCount} icmal atlandı");
            if (_job.UnknownPageCount > 0) parts.Add($"{_job.UnknownPageCount} sınıflandırılamadı");
            var label = $"{_job.TotalPages} sayfa analiz edildi — {string.Join(", ", parts)}";
            if (_job.RejectedServiceFeeCount > 0) label += $" · {_job.RejectedServiceFeeCount} reddedilen servis ücreti";
            return label;
        }
    }

    // Değer kolonu: Excel referans değeri (HakedisValue) tek renkli metin olarak gösterilir — Uygun ise
    // yeşil, değilse kırmızı; formdaki değer (FormValue) farklıysa yalnızca tooltip'te görünür (bkz. §11-12).
    private static Color ValueColor(AiComparisonResultDto r) => r.Status == "Uygun" ? Color.Success : Color.Error;
    private static string ValueDisplay(AiComparisonResultDto r) => !string.IsNullOrEmpty(r.HakedisValue) ? r.HakedisValue : (r.FormValue ?? "—");

    private static string ResultIcon(string status) => status switch
    {
        "Uygun" => "✅",
        "UygunDegil" => "🔴",
        "Eksik" or "Fazla" => "🟠",
        "ManuelKontrol" => "🟡",
        _ => "",
    };

    private static string ResultLabel(string status) => status switch
    {
        "Uygun" => "Uygun",
        "UygunDegil" => "Uygun Değil",
        "Eksik" => "Eksik",
        "Fazla" => "Fazla",
        "ManuelKontrol" => "Manuel Kontrol",
        _ => status,
    };

    private static string DocTypeLabel(string documentType) => documentType switch
    {
        "ServiceForm" => "Servis Formu",
        "PeriodicMaintenanceForm" => "Bakım Formu",
        "Summary" => "İcmal / Özet Sayfası",
        "Unknown" => "Sınıflandırılamadı",
        _ => documentType,
    };

    private async Task ProceedToResultsAsync()
    {
        await CheckService.SetStageAsync(Id, HakedisControlStage.FormReviewCompleted);
        Nav.NavigateTo($"/discipline/sogutma/kontrol/{Id}/sonuc");
    }
}
