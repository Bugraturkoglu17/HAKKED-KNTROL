<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Windows sürümü belirtilir: servis formundan form numarasını okumak için Windows'un yerleşik OCR'ı (Windows.Media.Ocr) kullanılır.
         Çıktı klasörü eskisiyle AYNI kalır (bin\Release\net8.0-windows) — ServisHakedis.exe'nin yeri değişmesin. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HakedisOtomasyon.Web</RootNamespace>
    <AssemblyName>ServisHakedis</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <InformationalVersion>1.1.0-sogutma-hakedis-kontrol-modulu</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HakedisOtomasyon.Infrastructure\HakedisOtomasyon.Infrastructure.csproj" />
    <ProjectReference Include="..\SogutmaHakedisKontrol.Infrastructure\SogutmaHakedisKontrol.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="SeedData\sogutma_hakedis_seed.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <!-- Soğutma disiplini başlangıç verisi: birim fiyat listesi + mağaza listesi (ilk açılışta içeri
         alınır, bkz. CoolingSeedService). Kurulum/publish çıktısına her zaman kopyalanır. -->
    <Content Update="SeedData\cooling_price_items.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Update="SeedData\cooling_stores.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\ReferenceTables\flexiva-table.png" />
    <EmbeddedResource Include="Assets\ReferenceTables\bdkf-table.png" />
    <EmbeddedResource Include="Assets\ReferenceTables\bdtx-table.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\ReferenceTables\POS_Malzeme_Eslesme_Claude_Hazir.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="Uninstall.bat" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <!-- .env örnek şablonu her zaman commit edilir. Gerçek .env (API key içerir) .gitignore'da
         hariç tutulur; varsa build çıktısına kopyalanır ki uygulama onu bulabilsin. -->
    <Content Include=".env.example">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include=".env" Condition="Exists('.env')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>