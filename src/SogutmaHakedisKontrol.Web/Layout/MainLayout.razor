@namespace SogutmaHakedisKontrol.Web.Layout
@inherits LayoutComponentBase

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.Large" FullWidth="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"
                       Title="Menüyü aç/kapat" />
        <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="ml-2">
            <MudIcon Icon="@Icons.Material.Outlined.AcUnit" Color="Color.Inherit" />
            <MudText Typo="Typo.h6" Style="font-weight:600;letter-spacing:.5px">
                Soğutma Hakediş Kontrolü
            </MudText>
        </MudStack>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Açık temaya geç" : "Koyu temaya geç")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@ToggleTheme" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="1"
               Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true"
               ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle2" Style="font-weight:600">Navigasyon</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565C0",
            PrimaryDarken = "#0D47A1",
            PrimaryLighten = "#1976D2",
            Secondary = "#00838F",
            AppbarBackground = "#1565C0",
            AppbarText = "#FFFFFF",
            DrawerBackground = "#FAFAFA",
            DrawerText = "#37474F",
            Surface = "#FFFFFF",
            Background = "#F5F7FA",
            TextPrimary = "#263238",
            TextSecondary = "#546E7A"
        },
        PaletteDark = new PaletteDark
        {
            Primary        = "#3b82f6",
            PrimaryDarken  = "#2563eb",
            PrimaryLighten = "#60a5fa",
            Secondary      = "#38bdf8",

            Info    = "#38bdf8",
            Success = "#22c55e",
            Warning = "#f59e0b",
            Error   = "#ef4444",

            Background = "#0f172a",
            Surface    = "#1e293b",

            AppbarBackground = "#0b1120",
            AppbarText       = "#f8fafc",
            DrawerBackground = "#0b1120",
            DrawerText       = "#cbd5e1",
            DrawerIcon       = "#94a3b8",

            TextPrimary   = "#f1f5f9",
            TextSecondary = "#94a3b8",
            TextDisabled  = "#475569",

            ActionDefault              = "#94a3b8",
            ActionDisabled             = "#475569",
            ActionDisabledBackground   = "rgba(255,255,255,0.04)",

            Divider      = "#334155",
            DividerLight = "rgba(255,255,255,0.06)",
            LinesDefault = "#334155",
            LinesInputs  = "#475569",

            TableLines   = "#334155",
            TableStriped = "rgba(255,255,255,0.03)",
            TableHover   = "rgba(59,130,246,0.10)",

            OverlayDark  = "rgba(0,0,0,0.55)",
            OverlayLight = "rgba(255,255,255,0.05)",
        },
        Typography = new Typography
        {
            Default = new Default { FontFamily = ["Roboto", "sans-serif"] }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleTheme() => _isDarkMode = !_isDarkMode;
}
