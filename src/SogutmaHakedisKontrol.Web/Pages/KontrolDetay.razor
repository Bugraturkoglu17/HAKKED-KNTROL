@page "/kontrol/{Id:int}"
@using SogutmaHakedisKontrol.Domain.Enums
@using SogutmaHakedisKontrol.Web.Components
@inject IProgressPaymentCheckService CheckService
@inject IDesktopFileService DesktopFile
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Hakediş Kontrol Sonucu</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_check is null)
{
    <MudAlert Severity="Severity.Error">Kontrol kaydı bulunamadı.</MudAlert>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:700">@_check.ClaimTypeName — @_check.PeriodLabel</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_check.CompanyName · @_check.Region · @_check.OriginalFileName</MudText>
        </div>
        <MudStack Row Spacing="1">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/">Kontrol Merkezi</MudButton>
            @if (_pendingCount > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RuleFolder"
                           OnClick="OpenMatchQueue">
                    Eşleşme Kontrolü (@_pendingCount)
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ExportAsync">
                Kontrol Edilmiş Excel'i İndir
            </MudButton>
            @if (_check.Status != ProgressPaymentCheckStatus.Tamamlandi)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           Disabled="@(_pendingCount > 0)" OnClick="FinalizeAsync">
                    Kontrolü Tamamla
                </MudButton>
            }
        </MudStack>
    </MudStack>

    @if (_pendingCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            @_pendingCount kalem tahmini eşleşme onayı bekliyor. Kontrolü tamamlamadan önce "Eşleşme Kontrolü" ile karar verin.
        </MudAlert>
    }

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="6" md="2"><KpiStat Label="Toplam Kalem" Value="@_check.TotalItemCount.ToString()" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Uygun" Value="@_check.UygunCount.ToString()" Color="Color.Success" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Onay Bekleyen" Value="@_check.OnayBekliyorCount.ToString()" Color="Color.Warning" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Hatalı" Value="@_check.HataliCount.ToString()" Color="Color.Error" /></MudItem>
        <MudItem xs="6" md="2"><KpiStat Label="Eşleşmeyen" Value="@_check.EslesmeyenCount.ToString()" Color="Color.Error" /></MudItem>
        <MudItem xs="6" md="2">
            <KpiStat Label="Toplam Fark" Value="@($"{_check.Difference:N2} TL")" Color="@(_check.Difference > 0 ? Color.Error : Color.Success)" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="6" md="4">
            <MudPaper Class="pa-2 text-center" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Firma Hakediş Toplamı</MudText>
                <MudText Typo="Typo.h6">@_check.CompanyTotal.ToString("N2") TL</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Class="pa-2 text-center" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Bizim Hesapladığımız Toplam</MudText>
                <MudText Typo="Typo.h6">@_check.CalculatedTotal.ToString("N2") TL</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Class="pa-2 text-center" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Kullanılan Ort. EUR/TL</MudText>
                <MudText Typo="Typo.h6">@(_check.ExchangeRateEur?.ToString("N4") ?? "—")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="2" Style="overflow-x:auto;max-width:100%">
        <MudTable Items="@_items" Dense Hover FixedHeader Height="600px" Style="min-width:1400px"
                  Filter="new Func<ProgressPaymentCheckItemDto, bool>(FilterFunc)" RowsPerPage="50">
            <ToolBarContent>
                <MudGrid Spacing="1" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_searchText" Placeholder="Malzeme veya mağaza ara..."
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate Dense Clearable Variant="Variant.Outlined" Class="mt-0" />
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                                    SelectedValue="_statusFilter" SelectedValueChanged="OnFilterChanged"
                                    Style="flex-wrap:wrap">
                            <MudChip T="string" Value="@("all")">Tümü</MudChip>
                            <MudChip T="string" Value="@("uygun")" Color="Color.Success">Uygun</MudChip>
                            <MudChip T="string" Value="@("hatali")" Color="Color.Error">Hatalı</MudChip>
                            <MudChip T="string" Value="@("eslesmeyen")" Color="Color.Error">Eşleşmeyen</MudChip>
                            <MudChip T="string" Value="@("onaybekleyen")" Color="Color.Warning">Onay Bekleyen</MudChip>
                        </MudChipSet>
                    </MudItem>
                </MudGrid>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Durum</MudTh>
                <MudTh>Mağaza</MudTh>
                <MudTh>Malzeme Adı (Firma)</MudTh>
                <MudTh>Eşleşen Kalem</MudTh>
                <MudTh>Miktar</MudTh>
                <MudTh>Birim</MudTh>
                <MudTh>Onaylı BF (TL)</MudTh>
                <MudTh>Firma BF</MudTh>
                <MudTh>Hesaplanan</MudTh>
                <MudTh>Firma Tutarı</MudTh>
                <MudTh>Fark</MudTh>
                <MudTh>Not</MudTh>
                <MudTh>İşlem</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.ControlStatus)">@context.ControlStatusLabel</MudChip></MudTd>
                <MudTd><MudText Typo="Typo.caption">@context.StoreName</MudText></MudTd>
                <MudTd>
                    <MudTooltip Text="@context.OriginalMaterialName">
                        <MudText Typo="Typo.body2" Style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                            @context.OriginalMaterialName
                        </MudText>
                    </MudTooltip>
                    @if (!string.IsNullOrWhiteSpace(context.OriginalMaterialSpec))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.OriginalMaterialSpec</MudText>
                    }
                </MudTd>
                <MudTd><MudText Typo="Typo.caption">@context.MatchedMaterialName</MudText></MudTd>
                <MudTd>@context.Quantity.ToString("N2")</MudTd>
                <MudTd>@context.Unit</MudTd>
                <MudTd>@(context.ApprovedUnitPriceTry?.ToString("N2") ?? "—")</MudTd>
                <MudTd>@context.CompanyUnitPrice.ToString("N2")</MudTd>
                <MudTd>@(context.CalculatedLineTotal?.ToString("N2") ?? "—")</MudTd>
                <MudTd>@context.CompanyLineTotal.ToString("N2")</MudTd>
                <MudTd Style="@FarkStyle(context.Difference)">@(context.Difference?.ToString("N2") ?? "—")</MudTd>
                <MudTd>
                    <MudTooltip Text="@context.ControlNote">
                        <MudText Typo="Typo.caption" Style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                            @context.ControlNote
                        </MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.FindReplace" Size="Size.Small" Title="Yeniden Eşleştir"
                                   OnClick="@(() => RematchAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Miktarı Düzelt"
                                   OnClick="@(() => EditQuantityAsync(context))" />
                    <MudIconButton Icon="@(context.IsExcluded ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                   Size="Size.Small" Title="Kontrol Dışı Bırak/Al" OnClick="@(() => ToggleExcludeAsync(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProgressPaymentCheckDto? _check;
    private List<ProgressPaymentCheckItemDto> _items = new();
    private bool _loading = true;
    private string _searchText = string.Empty;
    private string _statusFilter = "all";

    private int _pendingCount => _items.Count(i => i.MatchStatus == MaterialMatchStatus.FuzzyPending && !i.IsExcluded);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _check = await CheckService.GetByIdAsync(Id);
        _items = _check is null ? new() : await CheckService.GetItemsAsync(Id);
        _loading = false;
    }

    private void OnFilterChanged(string? value)
    {
        _statusFilter = value ?? "all";
    }

    private bool FilterFunc(ProgressPaymentCheckItemDto i)
    {
        if (_statusFilter == "uygun" && i.ControlStatus != CheckItemControlStatus.Uygun) return false;
        if (_statusFilter == "hatali" && i.ControlStatus is not (CheckItemControlStatus.FiyatHatasi or CheckItemControlStatus.BirimUyusmazligi)) return false;
        if (_statusFilter == "eslesmeyen" && i.ControlStatus != CheckItemControlStatus.BirimFiyatBulunamadi) return false;
        if (_statusFilter == "onaybekleyen" && i.ControlStatus != CheckItemControlStatus.OnayBekliyor) return false;

        if (!string.IsNullOrEmpty(_searchText))
        {
            var q = _searchText.Trim();
            return i.OriginalMaterialName.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (i.StoreName?.Contains(q, StringComparison.OrdinalIgnoreCase) == true);
        }
        return true;
    }

    private async Task OpenMatchQueue()
    {
        if (_check is null) return;
        var parameters = new DialogParameters
        {
            ["CheckId"] = Id,
            ["UnitPriceListId"] = _check.UnitPriceListId,
            ["CompanyName"] = _check.CompanyName,
        };
        var dialog = await DialogService.ShowAsync<MaterialMatchQueueDialog>("Eşleşme Kontrolü", parameters);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task RematchAsync(ProgressPaymentCheckItemDto item)
    {
        if (_check is null) return;
        var parameters = new DialogParameters
        {
            ["UnitPriceListId"] = _check.UnitPriceListId,
            ["InitialQuery"] = item.OriginalMaterialName,
        };
        var dialog = await DialogService.ShowAsync<ManualMaterialSearchDialog>("Doğru Malzemeyi Seçin", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is UnitPriceItemDto selected)
        {
            await CheckService.ResolveMatchAsync(Id, new List<int> { item.Id }, selected.Id, saveAsAlias: true, _check.CompanyName);
            await LoadAsync();
            Snackbar.Add("Eşleştirme güncellendi.", Severity.Success);
        }
    }

    private async Task EditQuantityAsync(ProgressPaymentCheckItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["MaterialName"] = item.OriginalMaterialName,
            ["CurrentQuantity"] = item.Quantity,
        };
        var dialog = await DialogService.ShowAsync<QuantityEditDialog>("Miktarı Düzelt", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is decimal newQty)
        {
            await CheckService.CorrectQuantityAsync(item.Id, newQty);
            await LoadAsync();
            Snackbar.Add("Miktar güncellendi.", Severity.Success);
        }
    }

    private async Task ToggleExcludeAsync(ProgressPaymentCheckItemDto item)
    {
        await CheckService.ExcludeItemAsync(item.Id, !item.IsExcluded);
        await LoadAsync();
    }

    private async Task FinalizeAsync()
    {
        await CheckService.FinalizeAsync(Id);
        await LoadAsync();
        Snackbar.Add("Kontrol tamamlandı.", Severity.Success);
    }

    private async Task ExportAsync()
    {
        try
        {
            var path = await CheckService.ExportControlledExcelAsync(Id);
            Snackbar.Add("Kontrol edilmiş Excel oluşturuldu.", Severity.Success);
            DesktopFile.OpenFile(path);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export hatası: {ex.Message}", Severity.Error);
        }
    }

    private static string FarkStyle(decimal? diff) => diff switch
    {
        > 0 => "color:var(--mud-palette-error);font-weight:600",
        < 0 => "color:var(--mud-palette-warning);font-weight:600",
        _ => ""
    };

    private static Color StatusColor(CheckItemControlStatus s) => s switch
    {
        CheckItemControlStatus.Uygun => Color.Success,
        CheckItemControlStatus.OnayBekliyor => Color.Warning,
        CheckItemControlStatus.KontrolDisi => Color.Default,
        CheckItemControlStatus.KontrolGerekli => Color.Info,
        _ => Color.Error
    };
}
